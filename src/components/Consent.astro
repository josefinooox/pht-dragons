---
// Analytics + consent. Configured at build time from public env vars (GitHub repository
// variables in the deploy workflow); a tool without its ID simply isn't loaded:
//   PUBLIC_UMAMI_ID     – Umami Cloud website ID (cookie-less page views and events, no consent needed)
//   PUBLIC_CLARITY_ID   – Microsoft Clarity project (heatmaps, recordings) – after consent
// The banner shows once (first visit) when a consent-based tool is configured; the choice is kept
// in localStorage "pht-consent" and can be changed via [data-consent-open] (footer link).
import { Cookie } from "@lucide/astro";

const umami = import.meta.env.PUBLIC_UMAMI_ID;
const needsConsent = !!import.meta.env.PUBLIC_CLARITY_ID;
---

{umami && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umami} />}

{
  needsConsent && (
    <div
      data-consent
      hidden
      role="dialog"
      aria-labelledby="consent-title"
      class="fixed inset-x-4 bottom-4 z-50 flex flex-col gap-4 rounded-lg border border-grey-300 bg-surface p-5 text-grey-950 shadow-xl md:right-auto md:left-6 md:max-w-md"
    >
      <p id="consent-title" class="flex items-center gap-3 font-display text-xl font-black uppercase">
        <Cookie size={26} class="shrink-0 text-red-600" aria-hidden="true" />
        Používáme cookies
      </p>
      <p class="text-base text-grey-600">
        Analytické cookies nám pomáhají zjistit, jak web používáš, abychom ho mohli vylepšovat. Volbu můžeš kdykoli změnit v
        patičce webu.
      </p>
      <div class="flex flex-wrap gap-3">
        <button
          type="button"
          data-consent-choice="yes"
          class="rounded-md bg-grey-950 px-4 py-3 font-display text-lg leading-6 font-bold text-on-ink uppercase transition-opacity hover:opacity-85"
        >
          Přijmout vše
        </button>
        <button
          type="button"
          data-consent-choice="no"
          class="btn-fill hover:text-on-ink focus-visible:text-on-ink rounded-md border border-grey-300 bg-surface px-4 py-3 font-display text-lg leading-6 font-bold text-grey-950 uppercase hover:border-grey-950"
        >
          Odmítnout
        </button>
      </div>
    </div>
  )
}

<script>
  const KEY = "pht-consent";
  const clarityId = import.meta.env.PUBLIC_CLARITY_ID as string | undefined;
  const banner = document.querySelector<HTMLElement>("[data-consent]");

  const get = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };
  let loaded = false;
  function load() {
    if (loaded) return;
    loaded = true;
    if (clarityId) {
      const w = window as unknown as { clarity?: ((...a: unknown[]) => void) & { q?: unknown[] } };
      w.clarity = w.clarity ?? Object.assign((...a: unknown[]) => (w.clarity!.q = w.clarity!.q ?? []).push(a), {});
      const s = document.createElement("script");
      s.async = true;
      s.src = `https://www.clarity.ms/tag/${clarityId}`;
      document.head.append(s);
      w.clarity("consent");
    }
  }
  function decide(value: "yes" | "no") {
    try {
      localStorage.setItem(KEY, value);
    } catch {}
    if (banner) banner.hidden = true;
    if (value === "yes") load();
    else if (loaded) location.reload(); // withdrawing consent: start again without the tools
  }

  if (banner) {
    const choice = get();
    if (choice === "yes") load();
    else if (choice === null) banner.hidden = false; // first visit
    for (const b of banner.querySelectorAll<HTMLButtonElement>("[data-consent-choice]"))
      b.addEventListener("click", () => decide(b.dataset.consentChoice as "yes" | "no"));
    for (const open of document.querySelectorAll("[data-consent-open]")) {
      (open as HTMLElement).hidden = false;
      open.addEventListener("click", () => (banner.hidden = false));
    }
  }
</script>
