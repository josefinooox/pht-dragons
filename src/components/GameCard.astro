---
// One of our games as a row (Figma "Frame 1948760502"): both logos, opponent, big date + time
// (or score), venue with map link, add-to-calendar link and "Detail zápasu".
// The whole card is clickable through an extra overlay link (hidden from assistive tech, the
// "Detail zápasu" button is the real one), so hovering the card doesn't put the button in its
// hover state. Buttons and links inside sit above the overlay.
import { CalendarPlus, Camera, MapPin } from "@lucide/astro";
import { OUR, forT, gameSlug, isFinal, mediaFor, opp, team, type Game } from "../lib/data";
import { dayMonthDot, mapUrl, weekdayShort } from "../lib/format";
import { url } from "../lib/url";
import Logo from "./Logo.astro";
import ResultChip from "./ResultChip.astro";
import When from "./When.astro";

interface Props {
  game: Game;
}
const { game: g } = Astro.props;
const o = opp(g);
const r = isFinal(g) ? forT(g, OUR) : null;
const slug = gameSlug(g);
const photos = r ? (mediaFor(g)?.photos.length ?? 0) : 0;
const inner = "relative z-10"; // links that must stay clickable above the stretched detail link
---

<li
  class="relative flex flex-col gap-4 rounded-lg bg-grey-100 px-4 py-4 transition-colors hover:bg-grey-200 sm:px-6 md:flex-row md:items-center md:justify-between"
>
  <a href={url(`zapas/${slug}`)} class="absolute inset-0 rounded-lg" tabindex="-1" aria-hidden="true"></a>
  <div class="flex min-w-0 items-center gap-4 md:gap-10">
    <div class="flex shrink-0 items-center gap-2" aria-hidden="true">
      <Logo id={g.homeTeamId} round class="size-12 md:size-16" />
      <Logo id={g.awayTeamId} round class="size-12 md:size-16" />
    </div>
    <div class="flex min-w-0 flex-col">
      <p class="flex items-center gap-2 font-display text-base leading-[1.4] font-bold uppercase text-grey-950">
        <span class="truncate">{team(o).name}</span>
        <When game={g} stateOnly class="text-sm" />
        {
          photos > 0 && (
            <span class="flex items-center gap-1 text-blue-600" title={`${photos} fotek`}>
              <Camera size={14} strokeWidth={2.5} aria-hidden="true" />
              <span class="sr-only">Fotky:</span>
              {photos}
            </span>
          )
        }
      </p>
      <p class="flex items-center gap-3 font-display text-[1.75rem] font-extrabold md:gap-4 md:text-[2.375rem]">
        <time datetime={g.start} class="contents">
          <span class="text-grey-500 opacity-80">{weekdayShort(g.date).toUpperCase()}</span>
          <span class="text-grey-950">{dayMonthDot(g.date)}</span>
          {!r && <span class="text-grey-950">{g.time}</span>}
        </time>
        {
          r && (
            <span class="flex items-center gap-2 text-grey-950">
              {g.homeGoals}:{g.awayGoals}
              <ResultChip result={r.r} />
            </span>
          )
        }
      </p>
      {
        g.venue && (
          <a
            href={mapUrl(g.venue)}
            target="_blank"
            rel="noopener"
            class:list={[
              inner,
              "link-underline flex w-fit items-center gap-1 text-base leading-[1.4] text-grey-950",
            ]}
          >
            <MapPin size={12} aria-hidden="true" />
            {g.venue}
            <span class="sr-only">(otevře mapu)</span>
          </a>
        )
      }
    </div>
  </div>

  <div class="flex items-center justify-between gap-4 md:justify-end md:gap-8">
    {
      !r && (
        <a
          href={url(`zapas/${slug}.ics`)}
          download={`dragons-${slug}.ics`}
          class:list={[
            inner,
            "link-underline flex shrink-0 items-center gap-1 font-display text-lg leading-6 font-bold whitespace-nowrap text-grey-600 uppercase hover:text-grey-950 focus-visible:text-grey-950",
          ]}
        >
          <CalendarPlus size={16} aria-hidden="true" />
          Přidat do kalendáře
        </a>
      )
    }
    <a
      href={url(`zapas/${slug}`)}
      class:list={[inner, "ml-auto flex min-w-20 shrink-0 items-center justify-center rounded-md bg-white p-3 whitespace-nowrap transition-colors hover:bg-grey-50 hover:text-blue-600 active:bg-grey-100 md:ml-0"]}
    >
      <span class="px-1 font-display text-lg leading-6 font-bold uppercase">Detail zápasu</span>
      <span class="sr-only">: {team(g.homeTeamId).name} – {team(g.awayTeamId).name}</span>
    </a>
  </div>
</li>
