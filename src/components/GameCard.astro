---
// One of our games as a row (Figma "Frame 1948760502"): both logos, opponent, big date + time
// (or score), venue with map link, add-to-calendar link and "Detail zápasu".
// The whole card is clickable through an extra overlay link (hidden from assistive tech, the
// "Detail zápasu" button is the real one), so hovering the card doesn't put the button in its
// hover state. Buttons and links inside sit above the overlay.
import { CalendarPlus, MapPin } from "@lucide/astro";
import { OUR, forT, gameSlug, isFinal, opp, team, type Game } from "../lib/data";
import { dayMonthDot, mapUrl, weekdayName, weekdayShort } from "../lib/format";
import { url } from "../lib/url";
import Logo from "./Logo.astro";
import ResultChip from "./ResultChip.astro";
import When from "./When.astro";

interface Props {
  game: Game;
  /** Position in the list for the staggered entrance animation (.enter in global.css). */
  enter?: number;
}
const { game: g, enter } = Astro.props;
const o = opp(g);
const r = isFinal(g) ? forT(g, OUR) : null;
const slug = gameSlug(g);
const inner = "relative z-10"; // links that must stay clickable above the stretched detail link
---

<!-- Mobile: one left edge, top to bottom: small logos + opponent, date/time (or score) as the
     main line, venue as quiet meta, then the actions under a hairline. Desktop: one row. -->
<li
  style={enter != null ? `--i:${enter}` : undefined}
  class:list={[enter != null && "enter", "relative flex flex-col gap-4 rounded-lg bg-grey-100 p-4 transition-colors hover:bg-grey-200 sm:px-6 md:flex-row md:items-center md:justify-between md:py-4"]}
>
  <a href={url(`zapas/${slug}`)} class="absolute inset-0 rounded-lg" tabindex="-1" aria-hidden="true"></a>
  <div class="flex min-w-0 items-center gap-4 md:gap-10">
    <div class="hidden shrink-0 items-center gap-2 md:flex" aria-hidden="true">
      <Logo id={g.homeTeamId} round class="size-16" />
      <Logo id={g.awayTeamId} round class="size-16" />
    </div>
    <div class="flex min-w-0 flex-col gap-1 md:gap-0">
      <p class="flex items-center gap-2 font-display text-lg leading-[1.4] font-bold text-grey-950 uppercase md:text-base">
        <span class="flex shrink-0 gap-1 md:hidden" aria-hidden="true">
          <Logo id={g.homeTeamId} round class="size-8" />
          <Logo id={g.awayTeamId} round class="size-8" />
        </span>
        <span class="truncate">{team(o).name}</span>
        <When game={g} stateOnly class="text-sm" />
      </p>
      <p class="flex items-center gap-3 font-display text-[2rem] leading-tight font-extrabold md:gap-4 md:text-[2.375rem] md:leading-normal">
        {
          r ? (
            <span class="flex items-center gap-2 text-grey-950">
              {g.homeGoals}:{g.awayGoals}
              <ResultChip result={r.r} />
            </span>
          ) : (
            <time datetime={g.start} class="contents">
              <span class="text-grey-500 opacity-80">{weekdayShort(g.date).toUpperCase()}</span>
              <span class="text-grey-950">{dayMonthDot(g.date)}</span>
              <span class="text-grey-950">{g.time}</span>
            </time>
          )
        }
      </p>
      <!-- played games: "Úterý 6.10." after the venue, 24px apart (on mobile it sits next to the button) -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
        {
          g.venue && (
            <a
              href={mapUrl(g.venue)}
              target="_blank"
              rel="noopener"
              class:list={[
                inner,
                "link-underline flex w-fit items-center gap-1 text-base leading-[1.4] text-grey-950 max-md:border-b-0 max-md:pb-0 max-md:text-grey-600",
              ]}
            >
              <MapPin size={14} class="shrink-0" aria-hidden="true" />
              {g.venue}
              <span class="sr-only">(otevře mapu)</span>
            </a>
          )
        }
        {
          r && (
            <time datetime={g.start} class="text-base leading-[1.4] text-grey-950 max-md:hidden">
              {weekdayName(g.date)} {dayMonthDot(g.date)}
            </time>
          )
        }
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between gap-4 border-t border-grey-300 pt-3 md:justify-end md:gap-8 md:border-0 md:pt-0">
    {
      r && (
        <time datetime={g.start} class="text-base leading-[1.4] text-grey-600 md:hidden">
          {weekdayName(g.date)} {dayMonthDot(g.date)}
        </time>
      )
    }
    {
      !r && (
        <a
          href={url(`zapas/${slug}.ics`)}
          download={`dragons-${slug}.ics`}
          class:list={[
            inner,
            "link-underline flex shrink-0 items-center gap-1 font-display text-base leading-6 font-bold whitespace-nowrap text-grey-600 uppercase hover:text-grey-950 focus-visible:text-grey-950 max-md:border-b-0 max-md:pb-0 md:text-lg",
          ]}
        >
          <CalendarPlus size={16} aria-hidden="true" />
          Přidat do kalendáře
        </a>
      )
    }
    <a
      href={url(`zapas/${slug}`)}
      class:list={[inner, "btn-fill hover:text-white focus-visible:text-white active:[--btn-fill:var(--color-grey-800)] ml-auto flex min-w-20 shrink-0 items-center justify-center rounded-md bg-white px-3 py-2 whitespace-nowrap text-grey-950 md:ml-0 md:p-3"]}
    >
      <span class="px-1 font-display text-base leading-6 font-bold uppercase md:text-lg">Detail zápasu</span>
      <span class="sr-only">: {team(g.homeTeamId).name} – {team(g.awayTeamId).name}</span>
    </a>
  </div>
</li>
