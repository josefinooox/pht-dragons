---
// One of our games as a row (Figma "Frame 1948760502"): both logos, opponent, big date + time
// (or score), venue with map link, add-to-calendar link and "Detail zápasu".
// The whole card is clickable through an extra overlay link (hidden from assistive tech, the
// "Detail zápasu" button is the real one), so hovering the card doesn't put the button in its
// hover state. Buttons and links inside sit above the overlay.
import { CalendarPlus, MapPin } from "@lucide/astro";
import { OUR, forT, gameSlug, isFinal, opp, team, teamSlug, type Game } from "../lib/data";
import { dayMonthDot, mapUrl, weekdayName, weekdayShort } from "../lib/format";
import { url } from "../lib/url";
import Logo from "./Logo.astro";
import ResultChip from "./ResultChip.astro";
import When from "./When.astro";

interface Props {
  game: Game;
}
const { game: g } = Astro.props;
const o = opp(g);
const r = isFinal(g) ? forT(g, OUR) : null;
const slug = gameSlug(g);
const inner = "relative z-10"; // links that must stay clickable above the stretched detail link
---

<!-- Layout follows the card's own width (container query, 60rem), not the viewport: the
     table panel can make the column narrow on desktop too.
     Narrow: one left edge, top to bottom: small logos + opponent, date/time (or score) as the
     main line, venue as quiet meta, then the actions under a hairline. Wide: one row. -->
<li class="@container relative rounded-lg bg-grey-100 transition-colors hover:bg-grey-200">
  <a href={url(`zapas/${slug}`)} class="absolute inset-0 rounded-lg" tabindex="-1" aria-hidden="true"></a>
  <div class="flex flex-col gap-4 p-4 sm:px-6 @min-[60rem]:flex-row @min-[60rem]:items-center @min-[60rem]:justify-between @min-[60rem]:py-4">
  <div class="flex min-w-0 items-center gap-4 @min-[60rem]:gap-10">
    <div class="hidden shrink-0 items-center gap-2 @min-[60rem]:flex" aria-hidden="true">
      <Logo id={g.homeTeamId} round class="size-16" />
      <Logo id={g.awayTeamId} round class="size-16" />
    </div>
    <div class="flex min-w-0 flex-col gap-1 @min-[60rem]:gap-0">
      <p class="flex items-center gap-2 font-display text-lg leading-[1.4] font-bold text-grey-950 uppercase @min-[60rem]:text-base">
        <span class="flex shrink-0 gap-1 @min-[60rem]:hidden" aria-hidden="true">
          <Logo id={g.homeTeamId} round class="size-8" />
          <Logo id={g.awayTeamId} round class="size-8" />
        </span>
        <a href={url(`tym/${teamSlug(o)}`)} class:list={[inner, "link-hover truncate"]}>{team(o).name}</a>
        <When game={g} stateOnly class="text-sm" />
      </p>
      <p class="flex items-center gap-3 font-display text-[2rem] leading-tight font-extrabold @min-[60rem]:gap-4 @min-[60rem]:text-[2.375rem] @min-[60rem]:leading-normal">
        {
          r ? (
            <span class="flex items-center gap-2 text-grey-950">
              {g.homeGoals}:{g.awayGoals}
              <ResultChip result={r.r} />
            </span>
          ) : (
            <time datetime={g.start} class="contents">
              <span class="text-grey-500 opacity-80">{weekdayShort(g.date).toUpperCase()}</span>
              <span class="text-grey-950">{dayMonthDot(g.date)}</span>
              <span class="text-grey-950">{g.time}</span>
            </time>
          )
        }
      </p>
      <!-- played games: "Úterý 6.10." after the venue, 24px apart (on mobile it sits next to the button) -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
        {
          g.venue && (
            <a
              href={mapUrl(g.venue)}
              target="_blank"
              rel="noopener"
              class:list={[
                inner,
                "link-underline flex w-fit items-center gap-1 text-base leading-[1.4] text-grey-950 @max-[60rem]:border-b-0 @max-[60rem]:pb-0 @max-[60rem]:text-grey-600",
              ]}
            >
              <MapPin size={14} class="shrink-0" aria-hidden="true" />
              {g.venue}
              <span class="sr-only">(otevře mapu)</span>
            </a>
          )
        }
        {
          r && (
            <time datetime={g.start} class="text-base leading-[1.4] text-grey-950 @max-[60rem]:hidden">
              {weekdayName(g.date)} {dayMonthDot(g.date)}
            </time>
          )
        }
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between gap-4 border-t border-grey-300 pt-3 @min-[60rem]:justify-end @min-[60rem]:gap-8 @min-[60rem]:border-0 @min-[60rem]:pt-0">
    {
      r && (
        <time datetime={g.start} class="text-base leading-[1.4] text-grey-600 @min-[60rem]:hidden">
          {weekdayName(g.date)} {dayMonthDot(g.date)}
        </time>
      )
    }
    {
      !r && (
        <a
          href={url(`zapas/${slug}.ics`)}
          download={`dragons-${slug}.ics`}
          class:list={[
            inner,
            "link-underline flex shrink-0 items-center gap-1 font-display text-base leading-6 font-bold whitespace-nowrap text-grey-600 uppercase hover:text-grey-950 focus-visible:text-grey-950 @max-[60rem]:border-b-0 @max-[60rem]:pb-0 @min-[60rem]:text-lg",
          ]}
        >
          <CalendarPlus size={16} aria-hidden="true" />
          Přidat do kalendáře
        </a>
      )
    }
    <a
      href={url(`zapas/${slug}`)}
      class:list={[inner, "btn-fill hover:text-on-ink focus-visible:text-on-ink active:[--btn-fill:var(--color-grey-800)] ml-auto flex min-w-20 shrink-0 items-center justify-center rounded-md bg-surface px-3 py-2 whitespace-nowrap text-grey-950 @min-[60rem]:ml-0 @min-[60rem]:p-3"]}
    >
      <span class="px-1 font-display text-base leading-6 font-bold uppercase @min-[60rem]:text-lg">Detail zápasu</span>
      <span class="sr-only">: {team(g.homeTeamId).name} – {team(g.awayTeamId).name}</span>
    </a>
  </div>
  </div>
</li>
