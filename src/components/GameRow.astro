---
// Compact row for another team's finished game (opponent analysis: "Jejich poslední zápasy").
import { forT, isFinal, opp, rankOf, team, type Game } from "../lib/data";
import { dayMonthDot, weekdayShort } from "../lib/format";
import Logo from "./Logo.astro";
import ResultChip from "./ResultChip.astro";

interface Props {
  game: Game;
  perspective: string;
}
const { game, perspective } = Astro.props;
const o = opp(game, perspective);
const r = isFinal(game) ? forT(game, perspective) : null;
const rank = rankOf(o);
---

<li class="flex items-center gap-4 border-b border-grey-300 py-3">
  <time datetime={game.start} class="w-16 shrink-0 font-display text-base font-bold text-grey-500 uppercase">
    {weekdayShort(game.date)} {dayMonthDot(game.date)}
  </time>
  <Logo id={o} round class="size-10" />
  <span class="min-w-0 flex-1 leading-tight">
    <span class="block truncate font-display text-base font-bold text-grey-950 uppercase">{team(o).name}</span>
    {rank && <span class="text-sm text-grey-500">{rank}. místo</span>}
  </span>
  {
    r ? (
      <span class="flex shrink-0 items-center gap-2">
        <span class="font-display text-[1.375rem] font-extrabold">
          {r.f}:{r.a}
        </span>
        <ResultChip result={r.r} />
      </span>
    ) : (
      <span class="font-display text-[1.375rem] font-extrabold">{game.time}</span>
    )
  }
</li>
