---
// Compact row for another team's finished game (opponent analysis).
import { forT, isFinal, opp, rankOf, team, type Game } from "../lib/data";
import { shortDate } from "../lib/format";
import Logo from "./Logo.astro";
import ResultChip from "./ResultChip.astro";

interface Props {
  game: Game;
  perspective: string;
}
const { game, perspective } = Astro.props;
const o = opp(game, perspective);
const r = isFinal(game) ? forT(game, perspective) : null;
const rank = rankOf(o);
---

<li class="flex items-center gap-3 border-b border-border py-2.5 last:border-b-0">
  <time datetime={game.start} class="label w-16 shrink-0 text-sm text-muted-foreground">{shortDate(game.date)}</time>
  <Logo id={o} class="size-7" />
  <span class="min-w-0 flex-1 leading-tight">
    <span class="block truncate font-semibold">{team(o).name}</span>
    {rank && <span class="text-sm text-muted-foreground">{rank}. v tabulce</span>}
  </span>
  {
    r ? (
      <span class="flex shrink-0 items-center gap-2">
        <span class="label text-xl tabular-nums">
          {r.f}:{r.a}
        </span>
        <ResultChip result={r.r} />
      </span>
    ) : (
      <span class="label text-xl">{game.time}</span>
    )
  }
</li>
