---
// Full standings for /tabulka, derived from the side panel (src/components/TablePanel.astro):
// round logos, our row blue-600/10, each row links to our nearest game against that team.
// The numbers sit close to the team names with generous spacing between them (the free space
// is left at the end of the row). Rows are grid links (not <tr>), so the whole row is one link.
// Narrow screens drop V–R–P.
import { OUR, standings, tableKnown, team, teamSlug } from "../lib/data";
import { plural } from "../lib/format";
import { url } from "../lib/url";
import Logo from "./Logo.astro";

const rows = standings.map((row) => {
  // every team links to its profile, ours included
  return { row, href: url(`tym/${teamSlug(row.teamId)}`) };
});
const grid =
  "grid grid-cols-[36px_48px_minmax(0,1fr)_36px_64px_44px] items-center md:grid-cols-[64px_56px_minmax(0,280px)_96px_120px_120px_96px]";
const wide = "hidden md:block";
---

<div class="font-display text-lg leading-[1.4] text-grey-950">
  <div class:list={[grid, "h-14 border-b border-grey-300 font-bold text-grey-500 uppercase"]} aria-hidden="true">
    <span class="pl-2 md:pl-4">#</span>
    <span class="col-span-2">Tým</span>
    <span class="px-2" title="Odehrané zápasy">Z</span>
    <span class:list={[wide, "px-2"]} title="Výhry–remízy–prohry">V–R–P</span>
    <span class="px-2">Skóre</span>
    <span class="px-2">Body</span>
  </div>
  {!tableKnown && <p class="px-4 py-8 font-sans text-base text-grey-600">Tabulka se zobrazí, jakmile ji liga zveřejní.</p>}
  <ol>
    {
      rows.map(({ row, href }) => {
        const us = row.teamId === OUR;
        const Tag = href ? "a" : "div";
        return (
          <li>
            <Tag
              href={href ?? undefined}
              aria-current={us ? "true" : undefined}
              class:list={[
                grid,
                "min-h-14 border-b border-grey-300 py-2",
                us ? "bg-blue-600/10 transition-colors hover:bg-blue-600/15" : "transition-colors hover:bg-grey-50 active:bg-grey-100",
              ]}
            >
              <span class="pl-2 font-bold md:pl-4">
                {row.rank}
                <span class="sr-only">. místo</span>
              </span>
              <span>
                <Logo id={row.teamId} round class="size-10" />
              </span>
              <span class:list={["truncate pr-2", us && "font-bold"]}>{team(row.teamId).name}</span>
              <span class="px-2">
                {row.played}
                <span class="sr-only"> {plural(row.played, "zápas", "zápasy", "zápasů")}</span>
              </span>
              <span class:list={[wide, "px-2"]}>
                {row.wins}–{row.draws}–{row.losses}
                <span class="sr-only"> (výhry, remízy, prohry)</span>
              </span>
              <span class="px-2">
                {row.goalsFor}:{row.goalsAgainst}
                <span class="sr-only"> skóre</span>
              </span>
              <span class="px-2 text-xl font-bold">
                {row.points}
                <span class="sr-only"> {plural(row.points, "bod", "body", "bodů")}</span>
              </span>
            </Tag>
          </li>
        );
      })
    }
  </ol>
</div>
