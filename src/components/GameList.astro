---
// Our games grouped by month, as Sparta-style rows.
import type { Game } from "../lib/data";
import { monthLabel } from "../lib/format";
import GameCard from "./GameCard.astro";

interface Props {
  games: Game[];
  empty: string;
}
const { games, empty } = Astro.props;
const groups: { label: string; games: Game[] }[] = [];
for (const g of games) {
  const label = monthLabel(g.date);
  if (groups.at(-1)?.label !== label) groups.push({ label, games: [] });
  groups.at(-1)!.games.push(g);
}
---

{
  groups.length ? (
    <div class="space-y-8">
      {groups.map((m) => (
        <section>
          <h3 class="mb-3 text-muted-foreground">{m.label}</h3>
          <ul class="space-y-3">
            {m.games.map((g) => (
              <GameCard game={g} />
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <p class="text-muted-foreground">{empty}</p>
  )
}
