---
// Our games grouped by month (Figma: month label + rows).
import type { Game } from "../lib/data";
import { monthLabel } from "../lib/format";
import GameCard from "./GameCard.astro";

interface Props {
  games: Game[];
  empty: string;
}
const { games, empty } = Astro.props;
const groups: { label: string; games: Game[] }[] = [];
for (const g of games) {
  const label = monthLabel(g.date);
  if (groups.at(-1)?.label !== label) groups.push({ label, games: [] });
  groups.at(-1)!.games.push(g);
}
---

{
  groups.length ? (
    <div class="flex flex-col gap-8">
      {groups.map((m) => (
        <section class="flex flex-col gap-4">
          <h3 class="font-display text-2xl leading-[1.4] font-semibold text-grey-500 uppercase">{m.label}</h3>
          <ul class="flex flex-col gap-4">
            {m.games.map((g) => (
              <GameCard game={g} />
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <p class="text-grey-600">{empty}</p>
  )
}
