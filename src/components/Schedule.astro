---
// Homepage body for "/" (Nadcházející) and "/odehrane" (Minulé), Figma "Homepage/Desktop".
import { ahead, finals, heroGame, opp, pending, type Game } from "../lib/data";
import { url } from "../lib/url";
import CalendarMenu from "./CalendarMenu.astro";
import GameCard from "./GameCard.astro";
import GameList from "./GameList.astro";
import SubBar from "./SubBar.astro";
import TablePanel from "./TablePanel.astro";
import When from "./When.astro";

interface Props {
  tab: "upcoming" | "played";
}
const { tab } = Astro.props;
const tabs = [
  { key: "upcoming", href: url(), label: "Nadcházející" },
  { key: "played", href: url("odehrane"), label: "Minulé" },
];
// Games that should be over but have no result yet stay on top until the result arrives.
const top: Game[] = [...pending, ...(heroGame ? [heroGame] : [])];
const h2 = "font-display text-[1.875rem] leading-[1.4] font-black text-grey-950 uppercase";
---

<div class="flex items-stretch">
  <div class="min-w-0 flex-1">
    <!-- page grid: same left edge as header/footer; width up to 1280px, narrowed from the right
         (never shifted) when the table panel needs the room -->
    <div class="mr-4 ml-(--gutter) max-w-7xl md:mr-20">
      <SubBar />
    </div>

    <div class="mr-4 ml-(--gutter) flex max-w-7xl flex-col gap-10 pt-8 pb-20 md:mr-20 md:pt-10 md:pb-32">
      <div class="flex flex-col gap-6 md:gap-8">
        <div class="flex items-center justify-between gap-4">
          <h1 class="font-display text-[2.75rem] leading-none font-black text-grey-950 uppercase md:text-[3.5rem] md:leading-[56px]">Zápasy</h1>
          <CalendarMenu />
        </div>
        <nav aria-label="Filtr zápasů">
          <ul class="flex gap-6">
            {
              tabs.map((t) => (
                <li>
                  <a
                    href={t.href}
                    aria-current={tab === t.key ? "page" : undefined}
                    class="font-sans text-xl font-semibold text-grey-500 transition-colors hover:text-grey-700 aria-[current=page]:text-red-600"
                  >
                    {t.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      {
        tab === "upcoming" ? (
          <div class="flex flex-col gap-16">
            {top.length > 0 && (
              <section aria-labelledby="nejblizsi" class="flex flex-col gap-4">
                <div class="flex items-center gap-4">
                  <h2 id="nejblizsi" class={h2}>
                    Nejbližší zápas
                  </h2>
                  {heroGame && (
                    <When
                      game={heroGame}
                      class="rounded-full bg-grey-100 px-3 py-2 font-display text-base leading-[1.4] font-bold text-grey-950 uppercase"
                    />
                  )}
                </div>
                <ul class="flex flex-col gap-4">
                  {top.map((g, k) => (
                    <GameCard game={g} enter={k} />
                  ))}
                </ul>
              </section>
            )}
            <section aria-labelledby="dalsi" class="flex flex-col gap-4">
              <h2 id="dalsi" class={h2}>
                Další zápasy
              </h2>
              <GameList games={ahead.slice(1)} enter={top.length} empty="Žádné další zápasy." />
            </section>
          </div>
        ) : (
          <section aria-labelledby="minule">
            <h2 id="minule" class="sr-only">
              Minulé zápasy
            </h2>
            <GameList games={finals.slice().reverse()} empty="Zatím žádné odehrané zápasy." />
          </section>
        )
      }
    </div>
  </div>

  <TablePanel />
</div>
