---
// V / R / P result circle (design "Aktuální forma").
import type { Result } from "../lib/data";
import { resultName } from "../lib/format";

interface Props {
  result: Result;
  size?: "sm" | "md";
}
const { result, size = "md" } = Astro.props;
const colors = { V: "bg-win text-white", R: "bg-draw text-grey-600", P: "bg-loss text-white" }[result];
---

<abbr
  title={resultName[result]}
  aria-label={resultName[result]}
  class:list={[
    "inline-grid shrink-0 place-items-center rounded-full font-display font-bold uppercase leading-none",
    colors,
    size === "sm" ? "size-5 text-sm" : "size-6 text-base",
  ]}>{result}</abbr
>
