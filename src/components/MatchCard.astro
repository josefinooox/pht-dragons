---
// The emphasized match (reference shot 1): date + state, faceoff with big time/score,
// venue with map link, calendar + share actions.
import { ArrowRight, CalendarPlus, MapPin, Share2, Star } from "@lucide/astro";
import { SRAZ_MIN, gameSlug, isFinal, rankOf, state, team, type Game } from "../lib/data";
import { longDate, mapUrl, minusMinutes } from "../lib/format";
import { url } from "../lib/url";
import Logo from "./Logo.astro";
import When from "./When.astro";

interface Props {
  game: Game;
  detailLink?: boolean;
  stars?: boolean;
}
const { game: g, detailLink = false, stars = false } = Astro.props;
const final = isFinal(g);
const s = state(g);
const slug = gameSlug(g);
const home = team(g.homeTeamId);
const away = team(g.awayTeamId);
const shareText = `${home.name} vs ${away.name}, ${longDate(g.date)} ${g.time}${g.venue ? `, ${g.venue}` : ""}`;
const sides = [g.homeTeamId, g.awayTeamId];
---

<div class="rounded-2xl bg-card p-4 sm:p-6">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <time datetime={g.start} class="label text-base sm:text-lg">{longDate(g.date)}</time>
    <When game={g} class="rounded-full bg-white px-3 py-1 text-sm" />
  </div>

  <div class="mt-5 grid grid-cols-[1fr_auto_1fr] items-start gap-2 sm:mt-6 sm:gap-6">
    {
      sides.map((id, i) => (
        <div class:list={["flex flex-col items-center text-center", i === 1 && "order-3"]}>
          <Logo id={id} class="size-14 sm:size-20" />
          <span class="label mt-2 text-base leading-tight sm:text-xl">{team(id).name}</span>
          {rankOf(id) && <span class="text-sm text-muted-foreground">{rankOf(id)}. místo</span>}
        </div>
      ))
    }
    <div class="order-2 flex flex-col items-center pt-2 text-center sm:pt-3">
      {
        final ? (
          <>
            <span class="label text-xs text-muted-foreground sm:text-sm">Konečný výsledek</span>
            <span class="label text-5xl leading-none tabular-nums sm:text-7xl">
              {g.homeGoals}:{g.awayGoals}
            </span>
          </>
        ) : (
          <>
            <span class="label text-xs text-muted-foreground sm:text-sm">Začátek</span>
            <span class="label text-5xl leading-none tabular-nums sm:text-7xl">{g.time}</span>
            <span class="label mt-1 text-sm text-primary sm:text-base">Sraz {minusMinutes(g.time, SRAZ_MIN)}</span>
          </>
        )
      }
    </div>
  </div>

  {
    g.venue && (
      <a
        href={mapUrl(g.venue)}
        target="_blank"
        rel="noopener"
        class="mt-5 flex items-center justify-center gap-1.5 font-semibold underline decoration-border decoration-2 underline-offset-4 hover:decoration-primary"
      >
        <MapPin size={18} class="shrink-0 text-primary" aria-hidden="true" />
        {g.venue}
        <span class="sr-only">(otevře mapu)</span>
      </a>
    )
  }

  {
    stars && final && g.stars.length > 0 && (
      <ul class="mt-5 flex flex-wrap justify-center gap-2">
        {g.stars.map((st) => (
          <li class="flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-sm">
            <Star size={14} class="fill-primary text-primary" aria-label="Hvězda zápasu" />
            <span class="font-semibold">
              {st.firstName} {st.lastName}
            </span>
            {st.number !== null && <span class="text-muted-foreground">#{st.number}</span>}
            <span class="label text-muted-foreground">{team(st.teamId).shortName}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    (s === "upcoming" || s === "live") && (
      <div class="mt-5 flex flex-col gap-2 sm:flex-row">
        <a
          href={url(`zapas/${slug}.ics`)}
          download={`dragons-${slug}.ics`}
          class="label flex flex-1 items-center justify-center gap-2 rounded-lg bg-secondary px-5 py-3.5 text-lg leading-none text-secondary-foreground transition-colors hover:bg-black"
        >
          <CalendarPlus size={20} aria-hidden="true" />
          Přidat do kalendáře
        </a>
        <button
          type="button"
          data-share
          data-url={url(`zapas/${slug}`)}
          data-text={shareText}
          hidden
          class="label flex items-center justify-center gap-2 rounded-lg border-2 border-secondary px-5 py-3 text-lg leading-none transition-colors hover:bg-white"
        >
          <Share2 size={20} aria-hidden="true" />
          Sdílet
        </button>
        <span role="status" class="self-center text-sm text-muted-foreground empty:hidden"></span>
      </div>
    )
  }

  {
    detailLink && (
      <a
        href={url(`zapas/${slug}`)}
        class="label mt-4 flex items-center justify-center gap-1.5 text-base text-primary hover:underline"
      >
        Detail zápasu a rozbor soupeře
        <ArrowRight size={18} strokeWidth={2.5} aria-hidden="true" />
      </a>
    )
  }
</div>
