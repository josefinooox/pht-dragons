---
// Team logo, or the short name when there is none.
import { team } from "../lib/data";
import { url } from "../lib/url";

interface Props {
  id: string;
}
const t = team(Astro.props.id);
---

{
  t.logo ? (
    <img class="logo" src={url(t.logo)} alt="" width="32" height="32" loading="lazy" />
  ) : (
    <abbr class="logo" title={t.name}>{t.shortName ?? "?"}</abbr>
  )
}
