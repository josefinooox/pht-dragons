---
// Standings side panel (Figma "Tabulka expanded" / "collapsed"), desktop only.
// Collapsed by default; the choice is remembered (localStorage, see src/scripts/table-panel.ts).
// State lives on <html data-table="open">, set before first paint by the inline script in Base,
// so a restored state doesn't animate; toggling animates the width and cross-fades the content.
import { TableProperties, X } from "@lucide/astro";
import { OUR, gameSlug, standings, team, teamTarget } from "../lib/data";
import { plural } from "../lib/format";
import { url } from "../lib/url";
import Logo from "./Logo.astro";

interface Props {
  highlight?: string[];
}
const { highlight = [] } = Astro.props;

// Five rows around us (one above, three below), like the design excerpt.
const ourIndex = standings.findIndex((r) => r.teamId === OUR);
const from = Math.max(0, Math.min(ourIndex - 1, standings.length - 5));
const rows = standings.slice(from, from + 5).map((row) => {
  const target = row.teamId === OUR ? undefined : teamTarget(row.teamId);
  return { row, href: target ? url(`zapas/${gameSlug(target)}`) : null };
});
// Each row is a plain block (a link when it leads to our game against that team): a real
// element instead of a stretched ::after, which can't be scoped to a table row reliably.
const grid = "grid grid-cols-[56px_56px_minmax(0,1fr)_56px_56px] items-center";
---

<aside class="table-panel relative hidden shrink-0 overflow-x-clip border-l border-grey-200 bg-white lg:block" aria-label="Tabulka">
  <!-- collapsed: the whole rail (full height) is the button; its content stays in view -->
  <button
    type="button"
    data-table-toggle="open"
    class="table-rail absolute inset-y-0 left-0 flex w-[73px] flex-col justify-start text-grey-500 transition-colors hover:bg-grey-100 hover:text-grey-700"
    aria-expanded="false"
    aria-controls="table-panel"
  >
    <span class="sticky top-0 flex flex-col items-center px-4 py-4">
      <span class="grid size-10 place-items-center rounded-lg">
        <TableProperties size={20} aria-hidden="true" />
      </span>
      <span class="mt-2 rotate-180 font-display text-2xl leading-[1.4] font-black uppercase [writing-mode:vertical-rl]">Tabulka</span>
    </span>
  </button>

  <!-- expanded -->
  <div id="table-panel" class="table-open sticky top-0 flex w-[420px] flex-col gap-6 px-6 py-6">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-[1.875rem] leading-[1.4] font-black text-grey-950 uppercase">Tabulka</h2>
      <button
        type="button"
        data-table-toggle="close"
        class="grid size-10 place-items-center rounded-full border border-grey-300 bg-white text-grey-950 transition-colors hover:bg-grey-100 active:bg-grey-200"
        aria-label="Zavřít tabulku"
        aria-controls="table-panel"
      >
        <X size={20} aria-hidden="true" />
      </button>
    </div>

    <div class="font-display text-base leading-[1.4] text-grey-950">
      <div class:list={[grid, "h-14 border-b border-grey-300 font-bold text-grey-500 uppercase"]} aria-hidden="true">
        <span class="pl-4">#</span>
        <span></span>
        <span class="px-2">Tým</span>
        <span class="px-2" title="Odehrané zápasy">Z</span>
        <span class="px-2">Body</span>
      </div>
      <ol>
        {
          rows.map(({ row, href }) => {
            const us = row.teamId === OUR;
            const Tag = href ? "a" : "div";
            return (
              <li>
                <Tag
                  href={href ?? undefined}
                  aria-current={us ? "true" : undefined}
                  class:list={[
                    grid,
                    "h-14 border-b border-grey-300",
                    us ? "bg-blue-600/10" : href && "transition-colors hover:bg-grey-50 active:bg-grey-100",
                    !us && highlight.includes(row.teamId) && "bg-grey-50",
                  ]}
                >
                  <span class="pl-4 font-bold">
                    {row.rank}
                    <span class="sr-only">. místo</span>
                  </span>
                  <span class="px-2">
                    <Logo id={row.teamId} round class="size-10" />
                  </span>
                  <span class="truncate px-2">{team(row.teamId).name}</span>
                  <span class="px-2">
                    {row.played}
                    <span class="sr-only"> {plural(row.played, "zápas", "zápasy", "zápasů")}</span>
                  </span>
                  <span class="px-2 font-bold">
                    {row.points}
                    <span class="sr-only"> {plural(row.points, "bod", "body", "bodů")}</span>
                  </span>
                </Tag>
              </li>
            );
          })
        }
      </ol>
    </div>

    <a
      href={url("tabulka")}
      class="self-end border-b border-blue-600 pb-1 font-display text-lg leading-6 font-bold text-blue-600 uppercase transition-colors hover:border-blue-700 hover:text-blue-700 active:text-blue-800"
    >
      Celá tabulka
    </a>
  </div>
</aside>

<style>
  /* Collapsed by default; <html data-table="open"> expands. The width eases, the rail fades out
     first and the panel fades/slides in slightly after. Hidden parts are `visibility: hidden`
     so they can't take focus or clicks. */
  .table-panel {
    --ease: cubic-bezier(0.32, 0.72, 0, 1);
    width: 73px;
    transition: width 380ms var(--ease);
  }
  .table-rail {
    transition: opacity 150ms ease, visibility 0s, background-color 150ms ease, color 150ms ease;
  }
  .table-open {
    opacity: 0;
    visibility: hidden;
    transform: translateX(24px);
    transition: opacity 150ms ease, transform 380ms var(--ease), visibility 0s linear 150ms;
  }
  :global(html[data-table="open"]) .table-panel { width: 420px; }
  :global(html[data-table="open"]) .table-rail {
    opacity: 0;
    visibility: hidden;
    transition: opacity 120ms ease, visibility 0s linear 120ms;
  }
  :global(html[data-table="open"]) .table-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 240ms ease 120ms, transform 380ms var(--ease), visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .table-panel, .table-rail, .table-open,
    :global(html[data-table="open"]) .table-rail,
    :global(html[data-table="open"]) .table-open { transition: none; }
  }
</style>

<script>
  import "../scripts/table-panel.ts";
</script>
