---
// Match detail card (Figma "Section - Zápas"): date and venue pills, big logos and team names,
// big score (played) or start time + meeting time (upcoming), game stars; the default slot
// (Dračí oko) sits inside the same card. Upcoming games get add-to-calendar and share instead.
import { CalendarPlus, MapPin, Share2, Star } from "@lucide/astro";
import { SRAZ_MIN, gameSlug, isFinal, rankOf, state, team, type Game } from "../lib/data";
import { longDate, mapUrl, minusMinutes } from "../lib/format";
import { url } from "../lib/url";
import Logo from "./Logo.astro";
import When from "./When.astro";

interface Props {
  game: Game;
}
const { game: g } = Astro.props;
const final = isFinal(g);
const s = state(g);
const slug = gameSlug(g);
const home = team(g.homeTeamId);
const away = team(g.awayTeamId);
const shareText = `${home.name} vs ${away.name}, ${longDate(g.date)} ${g.time}${g.venue ? `, ${g.venue}` : ""}`;
const upcoming = s === "upcoming" || s === "live";
const date = longDate(g.date);
const pill = "flex h-8 items-center gap-1.5 rounded-full bg-white px-3 text-base leading-[1.4] text-grey-950";
const big = "font-display text-[5rem] leading-none font-extrabold text-grey-950 md:text-[10rem]";
---

<section aria-label="Zápas" class="flex flex-col gap-8 rounded-lg bg-grey-100 px-5 py-6 md:gap-8 md:p-10">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <span class="flex items-center gap-2">
      <time datetime={g.start} class={pill}>{date.charAt(0).toUpperCase() + date.slice(1)}</time>
      <When game={g} class="flex h-8 items-center rounded-full bg-white px-3 font-display text-base font-bold text-grey-950 uppercase" />
    </span>
    {
      g.venue && (
        <a
          href={mapUrl(g.venue)}
          target="_blank"
          rel="noopener"
          class:list={[pill, "btn-fill hover:text-white focus-visible:text-white active:[--btn-fill:var(--color-grey-800)]"]}
        >
          <MapPin size={14} aria-hidden="true" />
          {g.venue}
          <span class="sr-only">(otevře mapu)</span>
        </a>
      )
    }
  </div>

  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 md:gap-8">
    {
      [g.homeTeamId, g.awayTeamId].map((id, i) => (
        <div class:list={["flex min-w-0 flex-col items-center gap-3 text-center", i === 1 && "order-3"]}>
          <Logo id={id} round class="size-16 md:size-24" />
          <div class="min-w-0">
            <p class="font-display text-xl leading-[1.2] font-bold text-grey-950 uppercase md:text-[2.5rem] md:leading-[1.4]">{team(id).name}</p>
            {rankOf(id) && <p class="text-sm leading-5 text-grey-600 md:text-base">{rankOf(id)}. místo</p>}
          </div>
        </div>
      ))
    }
    <div class="order-2 flex flex-col items-center gap-2 text-center">
      <span class="font-display text-sm leading-[1.4] font-bold text-grey-500 uppercase md:text-base">{final ? "Konečný výsledek" : "Začátek"}</span>
      {
        final ? (
          <span class:list={[big, "flex items-center"]} aria-label={`${g.homeGoals}:${g.awayGoals}`}>
            <span>{g.homeGoals}</span>
            <span class="px-1 md:px-4" aria-hidden="true">:</span>
            <span>{g.awayGoals}</span>
          </span>
        ) : (
          <>
            <span class:list={[big, "md:text-[7.5rem]"]}>{g.time}</span>
            <span class="font-display text-base leading-[1.4] font-bold text-red-600 uppercase md:text-lg">Sraz {minusMinutes(g.time, SRAZ_MIN)}</span>
          </>
        )
      }
    </div>
  </div>

  {
    final && g.stars.length > 0 && (
      <ul class="flex flex-wrap justify-center gap-2" aria-label="Hvězdy zápasu">
        {g.stars.map((st) => (
          <li class="flex h-8 items-center gap-1.5 rounded-full bg-white px-3 text-sm leading-5">
            <Star size={14} class="fill-red-600 text-red-600" aria-hidden="true" />
            <span class="font-semibold text-grey-950">
              {st.firstName} {st.lastName}
            </span>
            {st.number !== null && <span class="text-grey-500">#{st.number}</span>}
            <span class="font-display font-bold text-grey-500 uppercase">{team(st.teamId).shortName}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    upcoming && (
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a
          href={url(`zapas/${slug}.ics`)}
          download={`dragons-${slug}.ics`}
          class="link-underline flex items-center gap-1 font-display text-lg leading-6 font-bold whitespace-nowrap text-grey-600 uppercase hover:text-grey-950 focus-visible:text-grey-950"
        >
          <CalendarPlus size={16} aria-hidden="true" />
          Přidat do kalendáře
        </a>
        <button
          type="button"
          data-share
          data-url={url(`zapas/${slug}`)}
          data-text={shareText}
          hidden
          class="btn-fill flex min-w-20 items-center justify-center gap-1 rounded-md bg-white p-3 whitespace-nowrap text-grey-950 hover:text-white focus-visible:text-white active:[--btn-fill:var(--color-grey-800)]"
        >
          <Share2 size={16} aria-hidden="true" />
          <span class="px-1 font-display text-lg leading-6 font-bold uppercase">Sdílet</span>
        </button>
        <span role="status" class="text-sm text-grey-600 empty:hidden"></span>
      </div>
    )
  }

  <slot />
</section>
