---
// Big number with a label (stat tile). Proportional figures, condensed display face.
interface Props {
  label: string;
  value: string;
  sub?: string;
  size?: "md" | "lg" | "xl";
  tone?: "default" | "blue" | "red" | "green";
}
const { label, value, sub, size = "md", tone = "default" } = Astro.props;
const color = { default: "text-blue-600", blue: "text-blue-600", red: "text-red-600", green: "text-success" }[tone];
---

<div class="flex min-w-0 flex-col gap-1">
  <span class="font-display text-base leading-[1.4] font-bold text-grey-500 uppercase">{label}</span>
  <span class:list={["font-display leading-none font-extrabold", color, { md: "text-[2.5rem] md:text-5xl", xl: "text-[3.25rem] md:text-[4.5rem]", lg: "text-[4.5rem] md:text-[6rem]" }[size]]}>
    {value}
  </span>
  {sub && <span class="text-sm text-grey-600">{sub}</span>}
</div>
