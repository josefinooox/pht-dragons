---
// Head-to-head record per opponent: one stacked bar of wins / draws / losses (length = games
// played, so a 2–0–0 record is visibly shorter than 5–1–2), 2px gaps between segments,
// W–D–L as text at the end and the score under the name. Colors match the result dots.
interface Props {
  rows: { label: string; V: number; R: number; P: number; gf: number; ga: number }[];
}
const { rows } = Astro.props;
const max = Math.max(1, ...rows.map((r) => r.V + r.R + r.P));
const parts = [
  { k: "V", c: "bg-success", t: "výhry" },
  { k: "R", c: "bg-grey-400", t: "remízy" },
  { k: "P", c: "bg-red-600", t: "prohry" },
] as const;
---

<ul class="flex flex-col gap-3">
  {
    rows.map((r) => {
      const n = r.V + r.R + r.P;
      return (
        <li
          class="grid grid-cols-[minmax(0,7.5rem)_minmax(0,1fr)_4.5rem] items-center gap-x-3 md:grid-cols-[minmax(0,12rem)_minmax(0,1fr)_5rem]"
          title={`${r.label}: ${r.V} výher, ${r.R} remíz, ${r.P} proher, skóre ${r.gf}:${r.ga}`}
        >
          <span class="min-w-0">
            <span class="block truncate text-base text-grey-950">{r.label}</span>
            <span class="block font-display text-xs font-bold text-grey-500 uppercase">
              {n} {n === 1 ? "zápas" : n < 5 ? "zápasy" : "zápasů"} · {r.gf}:{r.ga}
            </span>
          </span>
          <span class="flex h-2 gap-[2px]" style={`width:${(100 * n) / max}%`}>
            {parts.map((p) => r[p.k] > 0 && <span class:list={["h-full min-w-2 rounded-full", p.c]} style={`flex:${r[p.k]}`} />)}
          </span>
          <span class="text-right font-display text-lg leading-none font-extrabold text-grey-950">
            {r.V}–{r.R}–{r.P}
          </span>
        </li>
      );
    })
  }
</ul>
