---
// Two series per category (us = blue-600, them = red-600) as paired horizontal bars sharing
// one scale, values at the tips, legend above. Used for goals by period.
interface Props {
  rows: { label: string; a: number; b: number }[];
  aLabel: string;
  bLabel: string;
}
const { rows, aLabel, bLabel } = Astro.props;
const max = Math.max(1, ...rows.flatMap((r) => [r.a, r.b]));
---

<div class="flex flex-col gap-4">
  <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-grey-600">
    <span class="flex items-center gap-2"><span class="h-3 w-4 rounded-r-[4px] bg-blue-600" />{aLabel}</span>
    <span class="flex items-center gap-2"><span class="h-3 w-4 rounded-r-[4px] bg-red-600" />{bLabel}</span>
  </div>
  <ul class="flex flex-col gap-4">
    {
      rows.map((r) => (
        <li class="grid grid-cols-[88px_minmax(0,1fr)] items-center gap-x-3">
          <span class="font-display text-base font-bold text-grey-950 uppercase">{r.label}</span>
          <span class="flex flex-col gap-[2px]">
            {[
              { v: r.a, c: "bg-blue-600", t: aLabel },
              { v: r.b, c: "bg-red-600", t: bLabel },
            ].map((s) => (
              <span class="flex items-center gap-2" title={`${r.label}, ${s.t}: ${s.v}`}>
                <span class:list={["block h-3 rounded-r-[4px]", s.c]} style={`width:${Math.max(1.5, (88 * s.v) / max)}%`} />
                <span class="font-display text-base leading-none font-extrabold text-grey-950">{s.v}</span>
              </span>
            ))}
          </span>
        </li>
      ))
    }
  </ul>
</div>
