---
// Goal difference per opponent around a neutral zero line: positive = blue-600 to the right,
// negative = red-600 to the left, zero = grey tick. Value and W–D–L as text on every row.
interface Props {
  rows: { label: string; diff: number; note: string }[];
}
const { rows } = Astro.props;
const max = Math.max(1, ...rows.map((r) => Math.abs(r.diff)));
const sign = (d: number) => (d > 0 ? `+${d}` : `${d}`);
---

<ul class="flex flex-col gap-2">
  {
    rows.map((r) => (
      <li class="grid grid-cols-[minmax(0,7.5rem)_minmax(0,1fr)_2.5rem] items-center gap-x-3 md:grid-cols-[minmax(0,12rem)_minmax(0,1fr)_3rem]" title={`${r.label}: rozdíl skóre ${sign(r.diff)}, ${r.note}`}>
        <span class="min-w-0">
          <span class="block truncate text-base text-grey-950">{r.label}</span>
          <span class="block font-display text-xs font-bold text-grey-500 uppercase">{r.note}</span>
        </span>
        <span class="relative h-2">
          <span class="absolute inset-y-[-4px] left-1/2 w-px bg-grey-400" aria-hidden="true" />
          {r.diff === 0 ? (
            <span class="absolute top-0 left-1/2 size-2 -translate-x-1/2 rounded-full bg-grey-500" />
          ) : r.diff > 0 ? (
            <span class="absolute top-0 left-1/2 h-2 min-w-2 rounded-full bg-blue-600" style={`width:${(50 * r.diff) / max}%`} />
          ) : (
            <span class="absolute top-0 right-1/2 h-2 min-w-2 rounded-full bg-red-600" style={`width:${(50 * -r.diff) / max}%`} />
          )}
        </span>
        <span class="text-right font-display text-lg leading-none font-extrabold text-grey-950">{sign(r.diff)}</span>
      </li>
    ))
  }
</ul>
