---
// Section headline that groups dashboard cards (e.g. "Dračí kronika").
interface Props {
  title: string;
  sub?: string;
}
const { title, sub } = Astro.props;
---

<div class="flex flex-col gap-1 pt-12 pb-2">
  <h2 class="font-display text-[1.875rem] leading-[1.4] font-black text-grey-950 uppercase md:text-[2.5rem] md:leading-[1.2]">{title}</h2>
  {sub && <p class="text-grey-500">{sub}</p>}
</div>
