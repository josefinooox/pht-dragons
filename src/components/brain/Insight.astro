---
// A fun fact on a blue cell, placed between charts to break up the dashboard. Either a sentence,
// or a big number with a short caption. Wording comes from insights in src/lib/brain.ts.
import type { InsightText } from "../../lib/brain";

interface Props {
  insight: InsightText | null;
  class?: string;
}
const { insight, class: cls } = Astro.props;
---

{
  insight && (
    <p class:list={["flex min-w-0 flex-col justify-between gap-6 rounded-lg bg-blue-600 p-6 text-white md:p-8", cls]}>
      <span class="font-display text-base font-bold text-blue-200 uppercase">Postřeh</span>
      {insight.big ? (
        <span class="flex flex-col gap-2">
          <span class="font-display text-[5rem] leading-[0.85] font-black md:text-[6.5rem]">{insight.big}</span>
          <span class="font-sans text-2xl leading-tight font-extrabold text-balance md:text-[1.75rem]">{insight.text}</span>
        </span>
      ) : (
        <span class="font-sans text-2xl leading-tight font-extrabold text-balance md:text-[2rem]">{insight.text}</span>
      )}
    </p>
  )
}
