---
// A fun fact placed between charts to break up the dashboard. Either a sentence, or a big
// number with a short caption. Three color variants alternate down the page.
// Wording comes from insights in src/lib/brain.ts.
import type { InsightText } from "../../lib/brain";

interface Props {
  insight: InsightText | null;
  tone?: "blue" | "white" | "grey";
  class?: string;
}
const { insight, tone = "blue", class: cls } = Astro.props;
const look = {
  blue: { box: "bg-blue-600 text-white", label: "text-blue-200" },
  white: { box: "bg-surface text-blue-600", label: "text-grey-500" },
  // light mode: a touch darker than grey-200 so it reads as a cell on the grey-100 page
  grey: { box: "bg-[#e5e5e5] text-blue-600 in-data-[theme=dark]:bg-grey-200", label: "text-grey-500" },
}[tone];
---

{
  insight && (
    <p class:list={["flex min-w-0 flex-col justify-between gap-6 rounded-lg p-6 md:p-8", look.box, cls]}>
      <span class:list={["font-display text-base font-bold uppercase", look.label]}>Postřeh</span>
      {insight.big ? (
        <span class="flex flex-col gap-2">
          <span class="font-display text-[5rem] leading-[0.85] font-black md:text-[6.5rem]">{insight.big}</span>
          <span class="font-sans text-[1.375rem] leading-tight font-extrabold text-balance md:text-[1.625rem]">{insight.text}</span>
        </span>
      ) : (
        <span class="font-sans text-[1.375rem] leading-tight font-extrabold text-balance md:text-[1.875rem]">{insight.text}</span>
      )}
    </p>
  )
}
