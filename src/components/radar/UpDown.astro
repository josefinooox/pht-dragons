---
// Us vs them per column around a shared zero line: ours up (blue), theirs down (red), both on
// one scale, values at the bar ends. Used for "zápas po zápase" (one column per game, each a
// link to the match) and "kdy padají góly" (one column per 5 minutes). Tooltips via data-tip.
import ResultChip from "../ResultChip.astro";
import type { Result } from "../../lib/data";

interface Props {
  items: { a: number; b: number; label: string; tip: string; href?: string; result?: Result }[];
  aLabel: string;
  bLabel: string;
  /** Pixel height of each half (up / down). */
  half?: number;
  /** Optional group headers above the columns, e.g. periods: span = number of columns. */
  groups?: { label: string; note?: string; span: number }[];
}
const { items, aLabel, bLabel, half = 96, groups } = Astro.props;
const max = Math.max(1, ...items.flatMap((i) => [i.a, i.b]));
const h = (v: number) => (v ? Math.max(8, (half * v) / max) : 0);
// long seasons (30+ games) get narrower columns; the strip scrolls sideways on phones
const cols = `repeat(${items.length}, minmax(${items.length > 14 ? "2rem" : "2.75rem"}, 1fr))`;
---

<figure class="flex flex-col gap-4">
  <figcaption class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-grey-600">
    <span class="flex items-center gap-2"><span class="h-2 w-4 rounded-full bg-blue-600"></span>{aLabel}</span>
    <span class="flex items-center gap-2"><span class="h-2 w-4 rounded-full bg-red-600"></span>{bLabel}</span>
  </figcaption>
  <div class="-mx-1 overflow-x-auto px-1 pb-1">
    <div class="grid min-w-full" style={`grid-template-columns:${cols}`}>
      {
        groups &&
          groups.map((g, k) => (
            <div class:list={["flex flex-col items-center pb-3 text-center", k > 0 && "border-l border-grey-300"]} style={`grid-column:span ${g.span}`}>
              <span class="font-display text-sm font-bold text-grey-500 uppercase">{g.label}</span>
              {g.note && <span class="font-display text-xl leading-tight font-extrabold text-grey-950">{g.note}</span>}
            </div>
          ))
      }
      {
        items.map((it, k) => {
          const Tag = it.href ? "a" : "div";
          const edge = groups && groups.slice(0, -1).reduce<number[]>((acc, g) => [...acc, (acc.at(-1) ?? 0) + g.span], []).includes(k);
          return (
            <Tag
              href={it.href}
              data-tip={it.tip}
              tabindex={it.href ? undefined : 0}
              aria-label={it.tip.replace(/\n/g, ", ")}
              class:list={[
                "group flex flex-col items-center rounded-md outline-offset-2 transition-colors",
                it.href && "hover:bg-grey-100",
                edge && "border-l border-grey-300",
              ]}
            >
              <span class="flex w-full flex-col items-center justify-end" style={`height:${half + 24}px`}>
                <span class:list={["pb-1 font-display text-base leading-none font-extrabold", it.a ? "text-blue-600" : "text-grey-400"]}>{it.a}</span>
                <span class="w-2.5 rounded-full bg-blue-600 transition-[filter] group-hover:brightness-110" style={`height:${h(it.a)}px`} />
              </span>
              <span class="my-1 h-px w-full bg-grey-400" aria-hidden="true" />
              <span class="flex w-full flex-col items-center justify-start" style={`height:${half + 24}px`}>
                <span class="w-2.5 rounded-full bg-red-600 transition-[filter] group-hover:brightness-110" style={`height:${h(it.b)}px`} />
                <span class:list={["pt-1 font-display text-base leading-none font-extrabold", it.b ? "text-red-600" : "text-grey-400"]}>{it.b}</span>
              </span>
              <span class="flex flex-col items-center gap-1 pt-2 pb-1">
                {it.result && <ResultChip result={it.result} size="sm" />}
                <span class="font-display text-xs font-bold whitespace-nowrap text-grey-500 uppercase">{it.label}</span>
              </span>
            </Tag>
          );
        })
      }
    </div>
  </div>
</figure>
