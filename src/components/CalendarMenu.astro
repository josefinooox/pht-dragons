---
// "Přidat do kalendáře" dropdown: subscribe to the season feed (webcal) or download the .ics.
// <details> keeps it working without JS; src/scripts/menus.ts closes it on outside click / Esc.
import { ChevronDown, Download, RefreshCw } from "@lucide/astro";
import { url } from "../lib/url";

interface Props {
  /** "outline": white with border (on white), "solid": white without border (on blue). */
  variant?: "outline" | "solid";
  /** Open the menu upwards (used in the footer). */
  up?: boolean;
  align?: "left" | "right";
}
const { variant = "outline", up = false, align = "right" } = Astro.props;
const feedHttp = new URL(url("dragons.ics"), Astro.site);
const feedWebcal = feedHttp.href.replace(/^https?:/, "webcal:");
---

<details class="group relative" data-menu>
  <summary
    class:list={[
      "btn-fill hover:text-white focus-visible:text-white active:[--btn-fill:var(--color-grey-800)] flex min-w-20 cursor-pointer list-none items-center justify-center gap-1 rounded-md bg-white p-3 text-grey-950 group-open:text-white [&::-webkit-details-marker]:hidden",
      variant === "outline" && "border border-grey-300 hover:border-grey-950 group-open:border-grey-950",
    ]}
  >
    <span class="px-1 font-display text-lg leading-6 font-bold uppercase">Přidat do kalendáře</span>
    <ChevronDown size={16} class="transition-transform group-open:rotate-180" aria-hidden="true" />
  </summary>
  <div
    class:list={[
      "absolute z-20 w-72 rounded-lg border border-grey-300 bg-white p-2 text-grey-950 shadow-lg",
      up ? "bottom-full mb-2" : "top-full mt-2",
      align === "right" ? "right-0" : "left-0",
    ]}
  >
    <a href={feedWebcal} class="flex gap-3 rounded-md p-3 transition-colors hover:bg-grey-100 active:bg-grey-200">
      <RefreshCw size={18} class="mt-0.5 shrink-0 text-blue-600" aria-hidden="true" />
      <span>
        <span class="block font-semibold">Odebírat celou sezónu</span>
        <span class="text-sm text-grey-600">Kalendář se sám aktualizuje při změnách.</span>
      </span>
    </a>
    <a href={feedHttp.href} download="dragons.ics" class="flex gap-3 rounded-md p-3 transition-colors hover:bg-grey-100 active:bg-grey-200">
      <Download size={18} class="mt-0.5 shrink-0 text-blue-600" aria-hidden="true" />
      <span>
        <span class="block font-semibold">Stáhnout soubor .ics</span>
        <span class="text-sm text-grey-600">Jednorázový import všech zápasů.</span>
      </span>
    </a>
  </div>
</details>

<script>
  import "../scripts/menus.ts";
</script>
