---
import { ChevronLeft } from "@lucide/astro";
import { OUR, meta, rankOf, standingOf, team } from "../lib/data";
import { plural } from "../lib/format";
import { url } from "../lib/url";
import CalendarMenu from "../components/CalendarMenu.astro";
import logo from "../assets/dragons-logo.svg";
import logoWhite from "../assets/dragons-logo-white.svg";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Which header nav item is current. */
  nav?: "rozpis" | "tabulka" | "radar";
  /** Back link in a grey bar under the header (detail pages). */
  back?: { href: string; label: string };
  /** Full-bleed main area: the page lays out its own columns (homepage with the table panel). */
  bare?: boolean;
}
const { title, description, nav, back, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const me = team(OUR);
const myRank = rankOf(OUR);
const myPoints = standingOf(OUR)?.points ?? 0;
const links = [
  { key: "rozpis", href: url(), label: "Rozpis" },
  { key: "tabulka", href: url("tabulka"), label: "Tabulka" },
  { key: "radar", href: url("radar"), label: "Dračí radar" },
] as const;
const updated = new Intl.DateTimeFormat("cs-CZ", {
  timeZone: "Europe/Prague",
  day: "numeric",
  month: "numeric",
  hour: "2-digit",
  minute: "2-digit",
}).formatToParts(new Date(meta.fetchedAt));
const part = (t: string) => updated.find((p) => p.type === t)?.value ?? "";
const updatedText = `${part("day")}. ${part("month")}. v ${part("hour")}:${part("minute")}`;
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#181818" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PHT Dragons" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {me.logo && <meta property="og:image" content={new URL(url(me.logo), Astro.site).href} />}
    {me.logo && <link rel="icon" href={url(me.logo)} type="image/webp" />}
    <link rel="alternate" type="text/calendar" title="Zápasy PHT Dragons" href={url("dragons.ics")} />
    <script is:inline>
      // Standings panel state before first paint (collapsed by default), see TablePanel.astro.
      try {
        if (localStorage.getItem("pht-table") === "open") document.documentElement.dataset.table = "open";
      } catch (e) {}
    </script>
  </head>
  <body class="bg-white text-grey-950 antialiased">
    <header class="bg-grey-900">
      <!-- header, main column and footer share the page grid (--gutter in global.css) -->
      <div class="flex h-[72px] items-center justify-between gap-4 px-(--gutter)">
        <a href={url()} class="shrink-0 rounded-sm" aria-label="PHT Dragons – rozpis">
          <img src={logo.src} alt="PHT Dragons" width="115" height="28" class="h-7 w-auto" />
        </a>
        <nav aria-label="Hlavní" class="hidden md:block">
          <ul class="flex gap-10">
            {
              links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={nav === l.key ? "page" : undefined}
                    class="font-sans text-base font-semibold text-grey-500 transition-colors hover:text-white aria-[current=page]:text-white"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          myRank && (
            <a
              href={url("tabulka")}
              class="flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 font-display text-sm leading-none font-bold text-white uppercase transition-colors hover:bg-white/20 md:hidden"
            >
              {myRank}. místo
              <span class="text-grey-400">
                {myPoints} {plural(myPoints, "bod", "body", "bodů")}
              </span>
            </a>
          )
        }
      </div>
    </header>

    {
      back && (
        <div class="bg-grey-100">
          <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-2.5">
            <a
              href={back.href}
              class="label flex items-center gap-1 text-sm text-grey-600 transition-colors hover:text-grey-950"
            >
              <ChevronLeft size={16} strokeWidth={3} aria-hidden="true" />
              {back.label}
            </a>
            <span class="label ml-auto text-sm">
              {meta.group.name} <span class="text-grey-600">{meta.season.name.replace(/-20/, "/")}</span>
            </span>
          </div>
        </div>
      )
    }

    {
      bare ? (
        <main class="flex-1">
          <slot />
        </main>
      ) : (
        <main class="mx-auto w-full max-w-6xl px-4 pt-8 pb-16 md:pt-12">
          <slot />
        </main>
      )
    }

    <footer class="bg-blue-600 text-white">
      <div class="flex flex-col gap-10 px-(--gutter) py-16 md:min-h-[410px] md:flex-row md:items-end md:justify-between md:py-24">
        <p class="font-display text-[2.75rem] leading-[1.1] font-black tracking-[-0.02em] uppercase md:text-[4.5rem]">
          <span class="block">PHT Dragons.</span>
          <span class="block text-blue-400">Máme sílu dračí.</span>
        </p>
        <div class="flex flex-col items-start gap-7">
          <p class="w-[259px] font-display text-[1.875rem] leading-[1.1] font-black tracking-[-0.02em] uppercase">
            Přidej si všechny zápasy do kalendáře
          </p>
          <CalendarMenu variant="solid" up align="left" />
        </div>
      </div>
      <div class="flex flex-col gap-6 px-(--gutter) pt-4 pb-8 font-sans text-base leading-[1.4] text-grey-50 md:gap-0 md:pb-0">
        <div class="flex flex-wrap items-center justify-between gap-6 md:h-[72px]">
          <a href={url()} class="shrink-0" aria-label="PHT Dragons – rozpis">
            <img src={logoWhite.src} alt="PHT Dragons" width="138" height="34" class="h-[34px] w-auto" />
          </a>
          <nav aria-label="Patička">
            <ul class="flex gap-10">
              {
                links.map((l) => (
                  <li>
                    <a href={l.href} class="transition-colors hover:text-blue-100 hover:underline hover:underline-offset-4">
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
        <p class="opacity-50 md:flex md:h-[72px] md:items-center md:justify-end">Data aktualizována {updatedText}</p>
      </div>
    </footer>
    <script>
      import "../scripts/live.ts";
    </script>
  </body>
</html>
