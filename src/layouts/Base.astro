---
import { ChevronLeft, Menu, Moon, Sun, X } from "@lucide/astro";
import { OUR, meta, team } from "../lib/data";
import { url } from "../lib/url";
import CalendarMenu from "../components/CalendarMenu.astro";
import logo from "../assets/dragons-logo.svg";
import logoWhite from "../assets/dragons-logo-white.svg";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Which header nav item is current. */
  nav?: "rozpis" | "tabulka" | "radar";
  /** Back link in a grey bar under the header (detail pages). */
  back?: { href: string; label: string };
  /** Full-bleed main area: the page lays out its own columns (homepage with the table panel). */
  bare?: boolean;
}
const { title, description, nav, back, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const me = team(OUR);
const links = [
  { key: "rozpis", href: url(), label: "Rozpis" },
  { key: "tabulka", href: url("tabulka"), label: "Tabulka" },
  { key: "radar", href: url("radar"), label: "Dračí radar" },
] as const;
const updated = new Intl.DateTimeFormat("cs-CZ", {
  timeZone: "Europe/Prague",
  day: "numeric",
  month: "numeric",
  hour: "2-digit",
  minute: "2-digit",
}).formatToParts(new Date(meta.fetchedAt));
const part = (t: string) => updated.find((p) => p.type === t)?.value ?? "";
const updatedText = `${part("day")}. ${part("month")}. v ${part("hour")}:${part("minute")}`;
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#181818" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PHT Dragons" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {me.logo && <meta property="og:image" content={new URL(url(me.logo), Astro.site).href} />}
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <link rel="alternate" type="text/calendar" title="Zápasy PHT Dragons" href={url("dragons.ics")} />
    <script is:inline>
      // Standings panel state before first paint (collapsed by default), see TablePanel.astro.
      try {
        if (localStorage.getItem("pht-table") === "open") document.documentElement.dataset.table = "open";
        // Theme before first paint (light by default), see the floating toggle below.
        if (localStorage.getItem("pht-theme") === "dark") document.documentElement.dataset.theme = "dark";
      } catch (e) {}
    </script>
  </head>
  <body class="bg-background text-grey-950 antialiased">
    <header class="bg-night-900">
      <!-- header, main column and footer share the page grid (--gutter in global.css) -->
      <div class="flex h-[72px] items-center justify-between gap-4 px-(--gutter)">
        <!-- the logo is a mask over colour layers, so hover can sweep white, then red, across it -->
        <a href={url()} class="logo-wipe shrink-0 rounded-sm" aria-label="PHT Dragons – rozpis">
          <span class="logo-wipe-fill" style={`--logo: url("${logo.src}")`} role="img" aria-label="PHT Dragons"></span>
        </a>
        <nav aria-label="Hlavní" class="hidden md:block">
          <ul class="flex gap-10">
            {
              links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={nav === l.key ? "page" : undefined}
                    class="font-sans text-base font-semibold text-night-500 transition-colors hover:text-white aria-[current=page]:text-white"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="group flex h-10 items-center gap-2 rounded-md bg-night-800 pr-3 pl-4 font-display text-base leading-none font-bold text-white uppercase transition-colors hover:bg-night-700 active:bg-night-600 md:hidden"
        >
          Menu
          <span class="relative size-5" aria-hidden="true">
            <Menu size={20} class="absolute inset-0 transition duration-300 group-aria-expanded:rotate-90 group-aria-expanded:opacity-0" />
            <X size={20} class="absolute inset-0 -rotate-90 opacity-0 transition duration-300 group-aria-expanded:rotate-0 group-aria-expanded:opacity-100" />
          </span>
        </button>
      </div>
      <!-- Mobile menu: the height opens with the same easing as the standings panel (0fr -> 1fr
           grid row), links fade and slide in. Closed = inert, so nothing in it is focusable. -->
      <div
        id="mobile-menu"
        data-open="false"
        inert
        class="group/menu grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] data-[open=true]:grid-rows-[1fr] motion-reduce:transition-none md:hidden"
      >
        <nav aria-label="Hlavní" class="min-h-0 overflow-hidden">
          <ul class="flex flex-col border-t border-white/10 px-(--gutter) pt-2 pb-6">
            {
              links.map((l, i) => (
                <li
                  class="-translate-y-2 opacity-0 transition duration-300 ease-out group-data-[open=true]/menu:translate-y-0 group-data-[open=true]/menu:opacity-100 motion-reduce:transition-none"
                  style={`transition-delay:${60 + i * 40}ms`}
                >
                  <a
                    href={l.href}
                    aria-current={nav === l.key ? "page" : undefined}
                    class="block py-3 font-display text-[2rem] leading-tight font-black text-night-500 uppercase transition-colors hover:text-white aria-[current=page]:text-white"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    {
      back && (
        <div class="bg-grey-100">
          <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-2.5">
            <a
              href={back.href}
              class="label flex items-center gap-1 text-sm text-grey-600 transition-colors hover:text-grey-950"
            >
              <ChevronLeft size={16} strokeWidth={3} aria-hidden="true" />
              {back.label}
            </a>
            <span class="label ml-auto text-sm">
              {meta.group.name} <span class="text-grey-600">{meta.season.name.replace(/-20/, "/")}</span>
            </span>
          </div>
        </div>
      )
    }

    {
      bare ? (
        <main class="flex-1">
          <slot />
        </main>
      ) : (
        <main class="mx-auto w-full max-w-6xl px-4 pt-8 pb-16 md:pt-12">
          <slot />
        </main>
      )
    }

    <footer class="bg-blue-600 text-white">
      <div class="flex flex-col gap-10 px-(--gutter) py-16 md:min-h-[410px] md:flex-row md:items-end md:justify-between md:py-24">
        <p class="font-display text-[2.75rem] leading-[1.1] font-black tracking-[-0.02em] uppercase md:text-[4.5rem]">
          <span class="block">PHT Dragons.</span>
          <span class="block text-blue-400">Máme sílu dračí.</span>
        </p>
        <div class="flex flex-col items-start gap-7">
          <p class="w-[259px] font-display text-[1.875rem] leading-[1.1] font-black tracking-[-0.02em] uppercase">
            Přidej si všechny zápasy do kalendáře
          </p>
          <CalendarMenu variant="solid" up align="left" />
        </div>
      </div>
      <div class="flex flex-col gap-6 px-(--gutter) pt-4 pb-8 font-sans text-base leading-[1.4] text-white md:gap-0 md:pb-0">
        <div class="flex flex-wrap items-center justify-between gap-6 md:h-[72px]">
          <a href={url()} class="shrink-0" aria-label="PHT Dragons – rozpis">
            <img src={logoWhite.src} alt="PHT Dragons" width="138" height="34" class="h-[34px] w-auto" />
          </a>
          <nav aria-label="Patička">
            <ul class="flex gap-10">
              {
                links.map((l) => (
                  <li>
                    <a href={l.href} class="transition-colors hover:text-blue-100 hover:underline hover:underline-offset-4">
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
        <p class="opacity-50 md:flex md:h-[72px] md:items-center md:justify-end">Data aktualizována {updatedText}</p>
      </div>
    </footer>
    <script>
      import "../scripts/live.ts";
    </script>
    <!-- Temporary theme switch (floating), until dark mode gets a place in the design. -->
    <button
      type="button"
      data-theme-toggle
      aria-pressed="false"
      class="fixed right-4 bottom-4 z-40 grid size-12 place-items-center rounded-full bg-grey-950 text-on-ink shadow-lg transition-transform hover:scale-105 active:scale-95 md:right-6 md:bottom-6"
    >
      <Moon size={20} class="in-data-[theme=dark]:hidden" aria-hidden="true" />
      <Sun size={20} class="hidden in-data-[theme=dark]:block" aria-hidden="true" />
      <span class="sr-only">Tmavý režim</span>
    </button>

    <script>
      // Theme toggle: html[data-theme="dark"] + localStorage "pht-theme".
      const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      if (themeButton) {
        const root = document.documentElement;
        const sync = () => themeButton.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
        sync();
        themeButton.addEventListener("click", () => {
          const dark = root.dataset.theme !== "dark";
          if (dark) root.dataset.theme = "dark";
          else delete root.dataset.theme;
          try {
            localStorage.setItem("pht-theme", dark ? "dark" : "light");
          } catch {}
          sync();
        });
      }
    </script>
    <script>
      // Mobile menu: toggle the panel under the header; close on Esc or when the viewport grows.
      const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      const menu = document.getElementById("mobile-menu");
      if (toggle && menu) {
        const isOpen = () => menu.dataset.open === "true";
        const set = (open: boolean) => {
          toggle.setAttribute("aria-expanded", String(open));
          menu.dataset.open = String(open);
          menu.inert = !open;
        };
        toggle.addEventListener("click", () => set(!isOpen()));
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) {
            set(false);
            toggle.focus();
          }
        });
        matchMedia("(min-width: 48rem)").addEventListener("change", (e) => e.matches && set(false));
      }
    </script>
  </body>
</html>
