---
import { OUR, finals, forT, rankOf, standingOf, team } from "../lib/data";
import { plural, resultName } from "../lib/format";
import { url } from "../lib/url";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const me = team(OUR);
const myRank = rankOf(OUR);
const myPoints = standingOf(OUR)?.points ?? 0;
const form = finals.slice(-5).map((g) => forT(g, OUR).r);
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PHT Dragons" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {me.logo && <meta property="og:image" content={new URL(url(me.logo), Astro.site).href} />}
    <link rel="alternate" type="text/calendar" title="Zápasy PHT Dragons" href={url("dragons.ics")} />
    <style is:global>
      /* Layout only. Visual design comes later. */
      body { margin: 0 auto; padding: 0 16px; max-width: 72rem; font-family: system-ui, sans-serif; }
      img { max-width: 100%; }
      .logo { width: 2rem; height: 2rem; object-fit: contain; vertical-align: middle; }
      .site-header { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding: 0.75rem 0; }
      .site-header .brand { margin-right: auto; }
      .form { display: inline-flex; gap: 0.25rem; }
      .cols { display: grid; gap: 1rem; }
      .faceoff { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.5rem; align-items: center; text-align: center; }
      .games { list-style: none; padding: 0; }
      .games li > * { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.5rem; padding: 0.25rem 0; }
      [data-when] { margin-right: 0.5em; }
      .table-wrap { overflow-x: auto; }
      table { border-collapse: collapse; }
      th, td { padding: 0.25rem 0.5rem; text-align: left; }
      .num { text-align: right; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .compare td:first-child, .compare th:first-child { text-align: right; }
      .compare td:last-child, .compare th:last-child { text-align: left; }
      .pn { display: flex; justify-content: space-between; gap: 1rem; }
      @media (min-width: 900px) {
        .cols { grid-template-columns: minmax(0, 1fr) 22rem; align-items: start; }
        .pos-chip { display: none; }
      }
      @media (max-width: 899px) {
        .side-table { display: none; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={url()}><Logo id={OUR} /> <b>{me.name}</b></a>
      {
        myRank && (
          <a class="pos-chip" href={url("tabulka")}>
            {myRank}. místo, {myPoints} {plural(myPoints, "bod", "body", "bodů")}
          </a>
        )
      }
      {
        form.length > 0 && (
          <span class="form" aria-label={`Forma, posledních ${form.length} zápasů`}>
            {form.map((r) => <abbr title={resultName[r]}>{r}</abbr>)}
          </span>
        )
      }
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        <small>PHM Cup, skupina KLASIK. Data z HMS, aktualizace každých 30 minut.</small>
      </p>
    </footer>
    <script>
      import "../scripts/live.ts";
    </script>
  </body>
</html>
