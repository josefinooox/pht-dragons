---
// "Dračí radar": the team's stats dashboard. Mostly big numbers and charts, little reading.
// All numbers come from src/lib/brain.ts at build time.
import Base from "../layouts/Base.astro";
import Card from "../components/brain/Card.astro";
import Stat from "../components/brain/Stat.astro";
import BarList from "../components/brain/BarList.astro";
import PointsChart from "../components/brain/PointsChart.astro";
import DuoBars from "../components/brain/DuoBars.astro";
import ResultBars from "../components/brain/ResultBars.astro";
import Insight from "../components/brain/Insight.astro";
import SectionHead from "../components/brain/SectionHead.astro";
import {
  allTime,
  assistPairs,
  firstGoal,
  goalies,
  headToHead,
  insights,
  leaders,
  periods,
  pointsTimeline,
  reportCount,
  rosterSize,
  season,
  specialTeams,
} from "../lib/brain";
import { standings } from "../lib/data";
import { num, plural } from "../lib/format";

const pct = (v: number | null) => (v == null ? "–" : `${Math.round(v)} %`);
const top = (list: { name: string; value: number; number: number | null }[], n = 5, fmt?: (v: number) => string) =>
  list.slice(0, n).map((p) => ({ label: p.name, value: p.value, display: fmt ? fmt(p.value) : String(p.value), note: p.number != null ? `#${p.number}` : undefined }));
const pim = (m: number) => `${Math.floor(m)}:${String(Math.round((m % 1) * 60)).padStart(2, "0")}`;
const wdl = (t: { V: number; R: number; P: number }) => `${t.V}–${t.R}–${t.P}`;
const tile = "rounded-lg bg-white p-5";
const ourWinPct = allTime.games ? (100 * allTime.wins) / allTime.games : 0;
---

<Base
  title="Dračí radar – PHT Dragons"
  description={`Statistiky PHT Dragons: ${season.points} bodů, ${season.wins} výher, ${season.gf}:${season.ga} skóre v sezóně ${season.name}.`}
  nav="radar"
  bare
>
  <div class="bg-grey-100">
  <div class="mr-4 ml-(--gutter) flex max-w-7xl flex-col gap-4 pt-8 pb-20 md:mr-20 md:pt-10 md:pb-32">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pb-4">
      <h1 class="font-display text-[3.5rem] leading-[56px] font-black text-grey-950 uppercase">Dračí radar</h1>
      <p class="font-sans text-xl font-semibold text-grey-500">Sezóna {season.name} v číslech</p>
    </div>

    <!-- row 1: position + results -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-[minmax(0,1.6fr)_repeat(4,minmax(0,1fr))]">
      <section aria-label="Pozice v tabulce" class="col-span-2 flex flex-col justify-between gap-4 rounded-lg bg-blue-600 p-6 text-white md:col-span-4 lg:col-span-1">
        <span class="font-display text-sm font-bold text-blue-100 uppercase">Pozice v tabulce</span>
        <div>
          <p class="flex items-baseline gap-3 font-display leading-[0.8] font-extrabold">
            <span class="text-[8rem] md:text-[10rem]">{season.rank ?? "–"}.</span>
            {standings.length > 0 && <span class="text-3xl font-bold text-blue-200">z {standings.length}</span>}
          </p>
          <p class="pt-3 font-display text-lg font-bold text-blue-100 uppercase">
            {season.points} {plural(season.points, "bod", "body", "bodů")} po {season.games} {plural(season.games, "zápase", "zápasech", "zápasech")}
          </p>
        </div>
      </section>
      <div class={tile}><Stat label="Výhry" value={String(season.wins)} tone="green" /></div>
      <div class={tile}><Stat label="Remízy" value={String(season.draws)} /></div>
      <div class={tile}><Stat label="Prohry" value={String(season.losses)} tone="red" /></div>
      <div class={tile}><Stat label="Skóre" value={`${season.gf}:${season.ga}`} /></div>
    </div>

    <!-- row 2: per-game numbers -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      <div class={tile}><Stat label="Góly na zápas" value={num(season.gfPerGame)} tone="blue" /></div>
      <div class={tile}><Stat label="Inkaso na zápas" value={num(season.gaPerGame)} tone="red" /></div>
      <div class={tile}><Stat label="Hráčů v sestavách" value={String(rosterSize)} /></div>
      <div class={tile}><Stat label="Trestné min. na zápas" value={pim(specialTeams.pimPerGame)} /></div>
    </div>

    <!-- how we play -->
    <SectionHead title="Jak hrajeme" sub="Průběh sezóny a kdy padají góly" />
    {insights.play.length > 0 && (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{insights.play.map((t) => <Insight text={t} />)}</div>
    )}
    <Card title="Průběh sezóny" subtitle="Body po každém zápase. Najeď na tečku pro detail zápasu.">
      <PointsChart points={pointsTimeline} />
    </Card>
    <div class="grid gap-4 lg:grid-cols-2">
      <Card title="Góly po třetinách" subtitle="Kdy skórujeme a kdy dostáváme">
        <DuoBars rows={periods.map((p) => ({ label: p.label, a: p.for, b: p.against }))} aLabel="Vstřelené" bLabel="Obdržené" />
      </Card>
      <Card title="Kdo dá první gól" subtitle="Výsledky (V–R–P) podle toho, kdo skóroval první">
        <div class="grid grid-cols-2 gap-6">
          <Stat label="My" value={wdl(firstGoal.us)} tone="blue" sub={`${firstGoal.us.games} ${plural(firstGoal.us.games, "zápas", "zápasy", "zápasů")}`} />
          <Stat label="Soupeř" value={wdl(firstGoal.them)} tone="red" sub={`${firstGoal.them.games} ${plural(firstGoal.them.games, "zápas", "zápasy", "zápasů")}`} />
        </div>
      </Card>
    </div>

    <!-- players -->
    <SectionHead title="Týmová práce" sub="Kdo dává góly, kdo nahrává a kdo nechybí" />
    {insights.team.length > 0 && (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{insights.team.map((t) => <Insight text={t} />)}</div>
    )}
    <div class="grid gap-4 md:grid-cols-3">
      <Card title="Kanadské body" subtitle="Góly + asistence"><BarList items={top(leaders.points)} /></Card>
      <Card title="Kanonýři" subtitle="Vstřelené góly"><BarList items={top(leaders.goals)} /></Card>
      <Card title="Nahrávači" subtitle="Asistence"><BarList items={top(leaders.assists)} /></Card>
      <Card title="Hvězdy zápasu" subtitle="Kolikrát byl hráč vyhlášen hvězdou">
        <BarList items={top(leaders.stars)} />
      </Card>
      <Card title="Nahrávací dvojice" subtitle="Kdo komu nejčastěji přihrál na gól">
        <BarList items={assistPairs.slice(0, 5).map((p) => ({ label: `${p.from} → ${p.to}`, value: p.count }))} />
      </Card>
      <Card title="Účast" subtitle={`Odehrané zápasy (z ${reportCount})`}>
        <BarList items={top(leaders.gamesPlayed)} max={reportCount} color="grey" />
      </Card>
    </div>

    <!-- goalies & special situations -->
    <SectionHead title="Brankáři a speciální situace" sub="Zákroky, přesilovky, oslabení a trestná lavice" />
    {insights.special.length > 0 && (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{insights.special.map((t) => <Insight text={t} />)}</div>
    )}
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <Card title="Brankáři" subtitle="Úspěšnost zákroků">
        {
          goalies.length ? (
            <div class="flex flex-col gap-5">
              {goalies.map((gk) => (
                <Stat
                  label={`${gk.name}${gk.number != null ? ` #${gk.number}` : ""}`}
                  value={gk.svPct == null ? "–" : `${num(gk.svPct)} %`}
                  sub={`${gk.games} ${plural(gk.games, "zápas", "zápasy", "zápasů")} · ${num(gk.gaa)} inkasovaných na zápas${gk.shutouts ? ` · ${gk.shutouts}× čisté konto` : ""}`}
                />
              ))}
            </div>
          ) : (
            <p class="text-grey-600">Zatím žádná data.</p>
          )
        }
      </Card>
      <Card title="Speciální formace">
        <div class="grid grid-cols-2 gap-x-6 gap-y-8">
          <Stat
            label="Přesilovky"
            value={pct(specialTeams.powerPlay.pct)}
            tone="blue"
            sub={`${specialTeams.powerPlay.goals} gólů z ${specialTeams.powerPlay.chances} přesilovek`}
          />
          <Stat
            label="Oslabení ubráněno"
            value={pct(specialTeams.penaltyKill.pct)}
            sub={`${specialTeams.penaltyKill.against} inkasované z ${specialTeams.penaltyKill.times} oslabení`}
          />
          <Stat
            label="Úspěšnost střelby"
            value={pct(specialTeams.shooting.pct)}
            sub={`${specialTeams.shooting.goals} gólů z ${specialTeams.shooting.shots} střel`}
          />
          <Stat
            label="Vyhraná vhazování"
            value={pct(specialTeams.faceoffs.pct)}
            sub={`${specialTeams.faceoffs.won} z ${specialTeams.faceoffs.all}`}
          />
        </div>
      </Card>
      <Card title="Trestná lavice" subtitle="Trestné minuty">
        <BarList items={top(leaders.penaltyMinutes, 5, pim)} color="grey" />
      </Card>
    </div>

    <!-- all seasons -->
    <SectionHead title="Dračí kronika" sub={`Všechny sezóny v PHM Cupu od ${allTime.bySeason[0]?.name ?? season.name}`} />
    {insights.history.length > 0 && (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{insights.history.map((t) => <Insight text={t} />)}</div>
    )}
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
        <div class={tile}><Stat label="Sezóny" value={String(allTime.seasons)} /></div>
        <div class={tile}><Stat label="Zápasy" value={String(allTime.games)} /></div>
        <div class={tile}><Stat label="Úspěšnost" value={`${Math.round(ourWinPct)} %`} tone="green" sub={`${allTime.wins}–${allTime.draws}–${allTime.losses}`} /></div>
        <div class={tile}><Stat label="Vstřelené góly" value={String(allTime.gf)} tone="blue" /></div>
        <div class={tile}><Stat label="Obdržené góly" value={String(allTime.ga)} tone="red" /></div>
        <div class={tile}>
          <Stat label="Nejvyšší výhra" value={allTime.biggestWin?.score ?? "–"} sub={allTime.biggestWin ? `s ${allTime.biggestWin.opponent}` : undefined} />
        </div>
      </div>
      <Card title="Úspěšnost po sezónách" subtitle="Podíl vyhraných zápasů">
        <BarList
          items={allTime.bySeason.map((s) => ({ label: s.name, value: s.winPct, display: `${Math.round(s.winPct)} %`, note: `${s.wins}–${s.draws}–${s.losses}` }))}
          max={100}
        />
      </Card>
    </div>

    <Card title="Proti komu nám to jde" subtitle="Bilance zápasů proti každému soupeři za všechny sezóny">
      <div slot="legend" class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-grey-600">
        <span class="flex items-center gap-2"><span class="h-2 w-4 rounded-full bg-success" />Výhry</span>
        <span class="flex items-center gap-2"><span class="h-2 w-4 rounded-full bg-grey-400" />Remízy</span>
        <span class="flex items-center gap-2"><span class="h-2 w-4 rounded-full bg-red-600" />Prohry</span>
      </div>
      <div class="columns-1 gap-10 lg:columns-2 [&>ul]:contents">
        <ResultBars rows={headToHead.map((h) => ({ label: h.name, V: h.V, R: h.R, P: h.P, gf: h.gf, ga: h.ga }))} />
      </div>
    </Card>
  </div>
  </div>
</Base>
