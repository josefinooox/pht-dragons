---
import Base from "../layouts/Base.astro";
import Schedule from "../components/Schedule.astro";
import { heroGame, opp, team } from "../lib/data";
import { longDate } from "../lib/format";

const next = heroGame
  ? `Nejbližší zápas: ${team(opp(heroGame)).name}, ${longDate(heroGame.date)} ${heroGame.time}.`
  : "Rozpis zápasů v PHM Cupu, skupina KLASIK.";
---

<Base title="PHT Dragons – rozpis" description={next}>
  <Schedule tab="upcoming" />
</Base>
