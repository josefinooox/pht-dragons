---
import type { GetStaticPaths } from "astro";
import { ChevronLeft } from "@lucide/astro";
import PillTabs from "../../components/PillTabs.astro";
import Base from "../../layouts/Base.astro";
import CompareTable from "../../components/CompareTable.astro";
import GameCard from "../../components/GameCard.astro";
import GameRow from "../../components/GameRow.astro";
import Gallery from "../../components/Gallery.astro";
import Logo from "../../components/Logo.astro";
import MatchHero from "../../components/MatchHero.astro";
import MatchRecap from "../../components/MatchRecap.astro";
import ResultChip from "../../components/ResultChip.astro";
import TablePanel from "../../components/TablePanel.astro";
import {
  OUR,
  commonOpponents,
  forT,
  gameSlug,
  isFinal,
  mediaFor,
  narrativeFor,
  reportFor,
  mine,
  opp,
  played,
  rankOf,
  stats,
  team,
  type Game,
} from "../../lib/data";
import { longDate, num, shortDate } from "../../lib/format";
import { opponentSummary } from "../../lib/summary";
import { buildRecap } from "../../lib/recap";
import { url } from "../../lib/url";

export const getStaticPaths = (() =>
  mine.map((game) => ({ params: { slug: gameSlug(game) }, props: { game } }))) satisfies GetStaticPaths;

const g = Astro.props.game as Game;
const o = opp(g);
const them = team(o);
const themShort = them.shortName ?? them.name;
const a = stats(OUR);
const b = stats(o);
const theirs = played(o).slice().reverse();
const form = played(o)
  .slice(-5)
  .map((x) => forT(x, o).r);
// Earlier meetings with this opponent this season that are already played.
const earlier = mine.filter((x) => opp(x) === o && x !== g && isFinal(x) && x.start < g.start).reverse();
const common = commonOpponents(o);
const final = isFinal(g);
const media = final ? mediaFor(g) : undefined;
const report = final ? reportFor(g) : undefined;
const recap = report ? buildRecap(g, report, OUR, them.name) : undefined;
const narrative = final ? narrativeFor(g) : undefined;

// Per-game comparison; "better" marks the better value (higher or lower is better).
const better = (x: number, y: number, higher = true) =>
  x === y ? null : (higher ? x > y : x < y) ? ("ours" as const) : ("theirs" as const);
const rows = [
  { label: "Body na zápas", ours: num(a.ppg), theirs: num(b.ppg), better: better(a.ppg, b.ppg) },
  { label: "Vstřelené góly na zápas", ours: num(a.gfpg), theirs: num(b.gfpg), better: better(a.gfpg, b.gfpg) },
  { label: "Obdržené góly na zápas", ours: num(a.gapg), theirs: num(b.gapg), better: better(a.gapg, b.gapg, false) },
  { label: "Trestné minuty na zápas", ours: num(a.pimpg), theirs: num(b.pimpg), better: better(a.pimpg, b.pimpg, false) },
  { label: "Odehrané zápasy", ours: String(a.gp), theirs: String(b.gp), better: null },
];

const home = team(g.homeTeamId).name;
const away = team(g.awayTeamId).name;
const title = `${home} vs ${away}, ${shortDate(g.date)}`;
const description = narrative
  ? narrative.summary
  : recap
  ? recap.summary
  : final
  ? `${home} ${g.homeGoals}:${g.awayGoals} ${away}, ${longDate(g.date)}. Rozbor soupeře ${them.name}.`
  : `${longDate(g.date)} ${g.time}${g.venue ? `, ${g.venue}` : ""}. Rozbor soupeře ${them.name}.`;

// Opponent card tabs (panel ids double as URL hashes).
const tabs = [
  { id: "shrnuti", label: "Shrnutí" },
  { id: "srovnani", label: "Srovnání" },
  { id: "posledni-zapasy", label: "Jejich poslední zápasy" },
  { id: "spolecni-souperi", label: "Společní soupeři" },
  ...(earlier.length ? [{ id: "predchozi-zapasy", label: earlier.length === 1 ? "Předchozí vzájemný zápas" : "Předchozí vzájemné zápasy" }] : []),
];
const h2 = "font-display text-[1.875rem] leading-[1.4] font-black text-grey-950 uppercase";
const h3 = "font-display text-2xl leading-[1.4] font-black text-grey-950 uppercase";
---

<Base title={title} description={description} nav="rozpis" bare>
  <div class="flex items-stretch">
    <div class="min-w-0 flex-1">
      <div class="mr-4 ml-(--gutter) flex max-w-7xl flex-col gap-8 pt-8 pb-20 md:mr-20 md:pt-10 md:pb-32">
        <nav aria-label="Drobečková navigace">
          <ol class="flex flex-wrap items-center gap-x-1 gap-y-1 text-base leading-6">
            <li>
              <a href={url()} class="flex items-center gap-1 text-grey-500 transition-colors hover:text-grey-950">
                <ChevronLeft size={18} aria-hidden="true" />
                Zápasy
              </a>
            </li>
            <li aria-hidden="true" class="text-grey-400">/</li>
            <li>
              <a href={final ? url("odehrane") : url()} class="text-grey-500 transition-colors hover:text-grey-950">
                {final ? "Minulé" : "Nadcházející"}
              </a>
            </li>
            <li aria-hidden="true" class="text-grey-400">/</li>
            <li aria-current="page" class="font-semibold text-grey-950">{home} vs {away}</li>
          </ol>
        </nav>
        <h1 class="sr-only">{home} vs {away}, {longDate(g.date)}</h1>

        <MatchHero game={g}>
          {recap && <MatchRecap recap={recap} narrative={narrative} opponent={o} ourShort={team(OUR).shortName ?? "My"} theirShort={themShort} />}
        </MatchHero>

        <section aria-labelledby="souper" class="flex flex-col gap-8 rounded-lg bg-grey-100 px-5 py-6 md:p-10">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <Logo id={o} round class="size-12" />
              <h2 id="souper" class={h2}>
                <span class="sr-only">Soupeř: </span>{them.name}
              </h2>
            </div>
            <div class="flex items-center gap-4">
              <span class="font-sans text-sm leading-[1.4] font-extrabold text-grey-950 uppercase">Forma</span>
              {
                form.length ? (
                  <span class="flex gap-1" aria-label={`Forma soupeře, posledních ${form.length} zápasů, od nejstaršího`}>
                    {form.map((r) => (
                      <ResultChip result={r} />
                    ))}
                  </span>
                ) : (
                  <span class="text-sm text-grey-600">zatím bez zápasu</span>
                )
              }
            </div>
          </div>

          <div data-tabs class="flex flex-col gap-6">
            <PillTabs tabs={tabs} label={`Rozbor soupeře ${them.name}`} />

            <div role="tabpanel" id="shrnuti" aria-labelledby="tab-shrnuti" tabindex="0" class="tab-panel flex flex-col gap-4">
              <h3 data-tab-title class={h3}>Shrnutí</h3>
              <p class="max-w-3xl text-lg leading-[1.6] text-grey-950 md:text-xl">{opponentSummary(o)}</p>
            </div>

            <div role="tabpanel" id="srovnani" aria-labelledby="tab-srovnani" tabindex="0" class="tab-panel flex flex-col gap-4">
              <h3 data-tab-title class={h3}>Srovnání</h3>
              <CompareTable
                opponent={o}
                rows={rows}
                note="Barevně je lepší hodnota. Průměry na zápas, protože týmy mají různý počet odehraných zápasů."
              />
            </div>

            <div role="tabpanel" id="posledni-zapasy" aria-labelledby="tab-posledni-zapasy" tabindex="0" class="tab-panel flex flex-col gap-4">
              <h3 data-tab-title class={h3}>Jejich poslední zápasy</h3>
              {
                theirs.length ? (
                  <div>
                    <ul>
                      {theirs.slice(0, 5).map((x) => (
                        <GameRow game={x} perspective={o} />
                      ))}
                    </ul>
                    {theirs.length > 5 && (
                      <details class="group">
                        <summary class="link-underline mt-4 w-fit cursor-pointer list-none font-display text-lg font-bold text-grey-600 uppercase hover:text-grey-950 [&::-webkit-details-marker]:hidden">
                          <span class="group-open:hidden">Všechny jejich zápasy ({theirs.length})</span>
                          <span class="hidden group-open:inline">Skrýt starší zápasy</span>
                        </summary>
                        <ul>
                          {theirs.slice(5).map((x) => (
                            <GameRow game={x} perspective={o} />
                          ))}
                        </ul>
                      </details>
                    )}
                  </div>
                ) : (
                  <p class="text-grey-600">Zatím bez odehraného zápasu.</p>
                )
              }
            </div>

            <div role="tabpanel" id="spolecni-souperi" aria-labelledby="tab-spolecni-souperi" tabindex="0" class="tab-panel flex flex-col gap-4">
              <h3 data-tab-title class={h3}>Společní soupeři</h3>
              {
                common.length ? (
                  <div class="flex flex-col gap-3">
                    <p class="text-grey-600">Jak jsme proti stejným týmům hráli my a jak oni.</p>
                    <table class="w-full">
                      <thead>
                        <tr class="border-b border-grey-300 font-display text-base font-bold text-grey-500 uppercase">
                          <th scope="col" class="py-3 text-left font-bold">Soupeř</th>
                          <th scope="col" class="py-3 text-right font-bold">{team(OUR).shortName}</th>
                          <th scope="col" class="py-3 pl-6 text-right font-bold">{themShort}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {common.map((c) => (
                          <tr class="border-b border-grey-300">
                            <th scope="row" class="py-3 text-left font-normal">
                              <span class="flex items-center gap-3">
                                <Logo id={c.x} round class="size-10" />
                                <span class="leading-tight">
                                  <span class="block font-display text-base font-bold text-grey-950 uppercase">{team(c.x).name}</span>
                                  <span class="text-sm text-grey-500">{rankOf(c.x) ?? "–"}. místo</span>
                                </span>
                              </span>
                            </th>
                            {[
                              { list: c.us, t: OUR },
                              { list: c.them, t: o },
                            ].map(({ list, t }, k) => (
                              <td class:list={["py-3 text-right align-middle", k === 1 && "pl-6"]}>
                                <span class="inline-flex flex-col items-end gap-1">
                                  {list.map((z) => {
                                    const r = forT(z, t);
                                    return (
                                      <span class="flex items-center gap-2">
                                        <span class="font-display text-[1.375rem] font-extrabold">
                                          {r.f}:{r.a}
                                        </span>
                                        <ResultChip result={r.r} />
                                      </span>
                                    );
                                  })}
                                </span>
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : (
                  <p class="text-grey-600">Zatím jsme nehráli proti žádnému stejnému soupeři.</p>
                )
              }
            </div>

            {
              earlier.length > 0 && (
                <div role="tabpanel" id="predchozi-zapasy" aria-labelledby="tab-predchozi-zapasy" tabindex="0" class="tab-panel flex flex-col gap-4">
                  <h3 data-tab-title class={h3}>
                    {earlier.length === 1 ? "Předchozí vzájemný zápas" : "Předchozí vzájemné zápasy"}
                  </h3>
                  <ul class="flex flex-col gap-4 [&>li]:bg-surface [&>li:hover]:bg-grey-50">
                    {earlier.map((x) => (
                      <GameCard game={x} />
                    ))}
                  </ul>
                </div>
              )
            }
          </div>
        </section>

        {media && <Gallery media={media} />}
      </div>
    </div>

    <TablePanel />
  </div>
</Base>

<style>
  /* Tab panels fade in when selected (src/scripts/tabs.ts toggles `hidden`). */
  .tab-panel:not([hidden]) {
    animation: tab-in 200ms ease;
  }
  @keyframes tab-in {
    from { opacity: 0; transform: translateY(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab-panel:not([hidden]) { animation: none; }
  }
  /* The tablist itself never shows a focus box around the whole strip; tabs have their own ring. */
  [role="tabpanel"]:focus-visible { outline-offset: 6px; }
</style>

<script>
  import "../../scripts/tabs.ts";
</script>
