---
import type { GetStaticPaths } from "astro";
import { ChevronLeft, ChevronRight, Sparkles } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import GameRow from "../../components/GameRow.astro";
import Logo from "../../components/Logo.astro";
import GameCard from "../../components/GameCard.astro";
import Gallery from "../../components/Gallery.astro";
import ResultChip from "../../components/ResultChip.astro";
import MatchCard from "../../components/MatchCard.astro";
import Standings from "../../components/Standings.astro";
import {
  OUR,
  commonOpponents,
  forT,
  gameSlug,
  isFinal,
  mediaFor,
  mine,
  opp,
  played,
  rankOf,
  stats,
  team,
  type Game,
} from "../../lib/data";
import { longDate, num, shortDate } from "../../lib/format";
import { opponentSummary } from "../../lib/summary";
import { url } from "../../lib/url";

export const getStaticPaths = (() =>
  mine.map((game) => ({ params: { slug: gameSlug(game) }, props: { game } }))) satisfies GetStaticPaths;

const g = Astro.props.game as Game;
const o = opp(g);
const them = team(o);
const themShort = them.shortName ?? them.name;
const i = mine.indexOf(g);
const prev = mine[i - 1];
const next = mine[i + 1];
const a = stats(OUR);
const b = stats(o);
const theirs = played(o).slice().reverse();
const form = played(o)
  .slice(-5)
  .map((x) => forT(x, o).r);
const meet = mine.filter((x) => opp(x) === o && x !== g);
const common = commonOpponents(o);
const final = isFinal(g);
const media = final ? mediaFor(g) : undefined;

// Per-game comparison; "better" marks the better value (higher or lower is better).
const better = (x: number, y: number, higher = true) => (x === y ? null : (higher ? x > y : x < y) ? "us" : "them");
const rows = [
  { label: "Body na zápas", us: num(a.ppg), them: num(b.ppg), better: better(a.ppg, b.ppg) },
  { label: "Vstřelené góly na zápas", us: num(a.gfpg), them: num(b.gfpg), better: better(a.gfpg, b.gfpg) },
  { label: "Obdržené góly na zápas", us: num(a.gapg), them: num(b.gapg), better: better(a.gapg, b.gapg, false) },
  { label: "Trestné minuty na zápas", us: num(a.pimpg), them: num(b.pimpg), better: better(a.pimpg, b.pimpg, false) },
  { label: "Odehrané zápasy", us: String(a.gp), them: String(b.gp), better: null },
];

const home = team(g.homeTeamId).name;
const away = team(g.awayTeamId).name;
const title = `${home} vs ${away}, ${shortDate(g.date)}`;
const description = final
  ? `${home} ${g.homeGoals}:${g.awayGoals} ${away}, ${longDate(g.date)}. Rozbor soupeře ${them.name}.`
  : `${longDate(g.date)} ${g.time}${g.venue ? `, ${g.venue}` : ""}. Rozbor soupeře ${them.name}.`;
---

<Base title={title} description={description} back={final ? { href: url("odehrane"), label: "Výsledky" } : { href: url(), label: "Rozpis" }}>
  <h1 class="text-[clamp(2.25rem,7vw,3.75rem)]">
    {home} <span class="text-primary">vs</span> {away}
  </h1>

  <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
    <div class="min-w-0 space-y-10">
      <div>
        <MatchCard game={g} stars />
        <nav class="mt-3 flex justify-between gap-4" aria-label="Předchozí a další zápas">
          {
            prev ? (
              <a href={url(`zapas/${gameSlug(prev)}`)} class="label flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground">
                <ChevronLeft size={16} strokeWidth={3} aria-hidden="true" />
                {shortDate(prev.date)} {team(opp(prev)).shortName ?? team(opp(prev)).name}
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={url(`zapas/${gameSlug(next)}`)} class="label flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground">
                {shortDate(next.date)} {team(opp(next)).shortName ?? team(opp(next)).name}
                <ChevronRight size={16} strokeWidth={3} aria-hidden="true" />
              </a>
            )
          }
        </nav>
      </div>

      {media && <Gallery media={media} />}

      <section aria-labelledby="souper" class="space-y-8">
        <div class="flex items-center gap-3">
          <Logo id={o} class="size-12" />
          <h2 id="souper">
            <span class="block text-base text-muted-foreground">Soupeř</span>
            {them.name}
          </h2>
        </div>

        <div class="rounded-2xl border-l-[6px] border-primary bg-card p-5">
          <p class="label flex items-center gap-1.5 text-sm text-primary">
            <Sparkles size={15} aria-hidden="true" /> Shrnutí
          </p>
          <p class="mt-2 text-lg leading-relaxed">{opponentSummary(o)}</p>
        </div>

        <div>
          <h3>Forma</h3>
          {
            form.length ? (
              <div class="mt-3 flex items-center gap-2">
                <span class="text-sm text-muted-foreground">nejstarší</span>
                {form.map((r) => (
                  <ResultChip result={r} />
                ))}
                <span class="text-sm text-muted-foreground">nejnovější</span>
              </div>
            ) : (
              <p class="mt-2 text-muted-foreground">Zatím bez odehraného zápasu.</p>
            )
          }
        </div>

        <div>
          <h3>Srovnání</h3>
          <table class="mt-3 w-full">
            <thead>
              <tr class="border-b-2 border-foreground">
                <th scope="col" class="label w-1/4 py-2 text-left">
                  <span class="flex items-center gap-2"><Logo id={OUR} class="size-6" /> PDG</span>
                </th>
                <th scope="col"><span class="sr-only">Ukazatel</span></th>
                <th scope="col" class="label w-1/4 py-2 text-right">
                  <span class="flex items-center justify-end gap-2">{themShort} <Logo id={o} class="size-6" /></span>
                </th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((r) => (
                  <tr class="border-b border-border">
                    <td class:list={["label py-3 text-left text-2xl", r.better === "us" ? "text-primary" : "text-muted-foreground/70"]}>
                      {r.us}
                    </td>
                    <th scope="row" class="px-2 py-3 text-center text-sm font-normal text-muted-foreground">
                      {r.label}
                    </th>
                    <td class:list={["label py-3 text-right text-2xl", r.better === "them" ? "text-accent" : "text-muted-foreground/70"]}>
                      {r.them}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="mt-2 text-sm text-muted-foreground">
            Barevně je lepší hodnota. Průměry na zápas, protože týmy mají různý počet odehraných zápasů.
          </p>
        </div>

        <div>
          <h3>Jejich poslední zápasy</h3>
          {
            theirs.length ? (
              <>
                <ul class="mt-2">
                  {theirs.slice(0, 5).map((x) => (
                    <GameRow game={x} perspective={o} />
                  ))}
                </ul>
                {theirs.length > 5 && (
                  <details class="group mt-1">
                    <summary class="label cursor-pointer py-2 text-primary">
                      <span class="group-open:hidden">Všechny jejich zápasy ({theirs.length})</span>
                      <span class="hidden group-open:inline">Skrýt starší zápasy</span>
                    </summary>
                    <ul>
                      {theirs.slice(5).map((x) => (
                        <GameRow game={x} perspective={o} />
                      ))}
                    </ul>
                  </details>
                )}
              </>
            ) : (
              <p class="mt-2 text-muted-foreground">Zatím bez odehraného zápasu.</p>
            )
          }
        </div>

        {
          common.length > 0 && (
            <div>
              <h3>Společní soupeři</h3>
              <p class="mt-1 text-muted-foreground">Jak jsme proti stejným týmům hráli my a jak oni.</p>
              <table class="mt-3 w-full">
                <thead>
                  <tr class="border-b-2 border-foreground">
                    <th scope="col" class="label py-2 text-left text-sm text-muted-foreground">Soupeř</th>
                    <th scope="col" class="label py-2 text-right text-sm">PDG</th>
                    <th scope="col" class="label py-2 pl-4 text-right text-sm">{themShort}</th>
                  </tr>
                </thead>
                <tbody>
                  {common.map((c) => (
                    <tr class="border-b border-border">
                      <th scope="row" class="py-2.5 text-left font-normal">
                        <span class="flex items-center gap-2.5">
                          <Logo id={c.x} class="size-7" />
                          <span class="leading-tight">
                            <span class="font-semibold">{team(c.x).name}</span>{" "}
                            <span class="text-sm text-muted-foreground">({rankOf(c.x) ?? "–"}.)</span>
                          </span>
                        </span>
                      </th>
                      {[
                        { list: c.us, t: OUR },
                        { list: c.them, t: o },
                      ].map(({ list, t }, k) => (
                        <td class:list={["py-2.5 text-right align-middle", k === 1 && "pl-4"]}>
                          <span class="inline-flex flex-col items-end gap-1">
                            {list.map((z) => {
                              const r = forT(z, t);
                              return (
                                <span class="flex items-center gap-1.5">
                                  <span class="label text-lg tabular-nums">
                                    {r.f}:{r.a}
                                  </span>
                                  <ResultChip result={r.r} size="sm" />
                                </span>
                              );
                            })}
                          </span>
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }

        {
          meet.length > 0 && (
            <div>
              <h3 class="mb-3">Další vzájemný zápas v sezóně</h3>
              <ul class="space-y-3">
                {meet.map((x) => (
                  <GameCard game={x} />
                ))}
              </ul>
            </div>
          )
        }
      </section>
    </div>

    <aside aria-labelledby="tabulka-h">
      <div class="flex items-baseline justify-between">
        <h2 id="tabulka-h">Tabulka</h2>
        <a href={url("tabulka")} class="label text-sm text-primary hover:underline">Celá tabulka</a>
      </div>
      <div class="mt-3">
        <Standings mode="around" compact highlight={[o]} />
      </div>
    </aside>
  </div>
</Base>
