---
import Base from "../layouts/Base.astro";
import Standings from "../components/Standings.astro";
import { OUR, heroGame, meta, opp, rankOf } from "../lib/data";
---

<Base
  title="Tabulka – PHT Dragons"
  description={`Tabulka skupiny KLASIK, ${meta.phase.name}. PHT Dragons na ${rankOf(OUR) ?? "–"}. místě.`}
  nav="tabulka"
>
  <h1>Tabulka</h1>
  <p class="mt-4 max-w-prose text-muted-foreground">
    Skupina {meta.group.name}, {meta.phase.name.toLowerCase()}, sezóna {meta.season.name}. Z = odehrané zápasy.
    Klikni na tým a uvidíš náš nejbližší zápas s ním.
  </p>
  <div class="mt-8">
    <Standings mode="full" highlight={heroGame ? [opp(heroGame)] : []} />
  </div>
</Base>
