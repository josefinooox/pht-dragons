---
// Standings page, derived from the homepage design: same page grid, sub-bar and big title;
// the table follows the side panel's style with more columns.
import Base from "../layouts/Base.astro";
import Standings from "../components/Standings.astro";
import SubBar from "../components/SubBar.astro";
import { OUR, meta, rankOf } from "../lib/data";
---

<Base
  title="Tabulka – PHT Dragons"
  description={`Tabulka skupiny KLASIK, ${meta.phase.name}. PHT Dragons na ${rankOf(OUR) ?? "–"}. místě.`}
  nav="tabulka"
  bare
>
  <div class="mr-4 ml-(--gutter) max-w-7xl md:mr-20">
    <SubBar />
  </div>

  <div class="mr-4 ml-(--gutter) flex max-w-7xl flex-col gap-10 pt-8 pb-20 md:mr-20 md:pt-10 md:pb-32">
    <div class="flex flex-col gap-4">
      <h1 class="font-display text-[3.5rem] leading-[56px] font-black text-grey-950 uppercase">Tabulka</h1>
      <p class="font-sans text-xl font-semibold text-grey-500">
        Skupina {meta.group.name}, {meta.phase.name.toLowerCase()}, sezóna {meta.season.name.replace("-", "/")}
      </p>
    </div>

    <section aria-label="Tabulka skupiny" class="rounded-lg bg-white">
      <Standings />
    </section>

    <p class="max-w-3xl text-sm text-grey-500">
      Z = odehrané zápasy, V–R–P = výhry, remízy a prohry. Klikni na tým a uvidíš náš nejbližší zápas s ním.
    </p>
  </div>
</Base>
